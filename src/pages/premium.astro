---
import Base from '../layouts/Base.astro';
import { docsCard } from '../lib/preview-card';
import { PAGINA_PIANI } from '../lib/pagina-piani';
import VetrinaFont from '../components/VetrinaFont.astro';
// vetrina.css prima di premium.css: le regole della pagina vengono dopo quelle comuni.
import '../styles/vetrina.css';
import '../styles/premium.css';
import Plans from '../components/premium/Plans.astro';
import Compare from '../components/premium/Compare.astro';
import Included from '../components/premium/Included.astro';

// La pagina per scegliere un piano (spec docs/superpowers/specs/2026-11-14-pagina-premium-design.md, nel repo
// team-tasks-manager). Il riferimento tecnico dei limiti resta /docs/premium/; i prezzi stanno solo qui.
// Niente data-pagefind-body: la ricerca copre la documentazione, e questa pagina si trova dal menu, dalle barre
// laterali e dai rimandi. Nella cartella dist/premium/ stanno anche le immagini che il bot linka
// (/premium/premium-*.png): la pagina ci finisce accanto, e i loro indirizzi non cambiano.
const TITLE = `${PAGINA_PIANI.title} — Team Tasks Manager`;
const EMBED = docsCard(PAGINA_PIANI.title, PAGINA_PIANI.description, PAGINA_PIANI.path, 'See the plans');

// Il Founder (spec docs/superpowers/specs/2026-11-15-founder-design.md): le cifre scritte, 5,000 e 30 giorni, sono
// regole vere; quella del prezzo Founder non c'è, finché il tracker non la fissa.
const PASSI = [
  {
    titolo: 'Reserve during the beta.',
    testo: 'Your server gets its Founder number the moment it reserves: the earlier, the lower. '
      + 'Without a reservation there is no Founder price and no badge.',
  },
  {
    titolo: 'Be one of the first 5,000 to buy.',
    testo: 'When Premium opens, reserved servers have 30 days to buy a full year at roughly half price. '
      + "There are 5,000, and a reservation doesn't hold one: they go to the first 5,000 servers that buy.",
  },
  {
    titolo: 'Or keep the badge at the regular price.',
    testo: 'Once the 5,000 are gone, a reserved server keeps its badge by buying a regular month or year within the '
      + 'same 30 days. After that the badge is lost, and its number is never given to anyone else.',
  },
];
const VANTAGGI = [
  {
    titolo: 'Your number, for good.',
    testo: 'Founder #N shows in the bot on your server, and it stays even if your Premium ends later.',
  },
  {
    titolo: 'A place on the Founders wall.',
    testo: "Your server's name and number on this site, if you want them there.",
  },
];
---
<Base title={TITLE} previewTitle={PAGINA_PIANI.title} description={PAGINA_PIANI.description} embed={EMBED}>
  <VetrinaFont slot="head" />
  <main class="vetrina">
    <section class="p-beta" aria-label="Open beta">
      <p class="wrap"><strong>Open beta.</strong> Every Premium feature is unlocked, for every server. Prices apply when the beta ends. <a class="h-link" href="/docs/beta/">How the beta works</a></p>
    </section>

    <section class="p-hero wrap">
      <h1><span>Start on Free.</span> <span>Grow into Premium.</span></h1>
      <p class="h-intro">Free covers a small team, and stays free. Premium lifts the limits for the servers that need more, with one price for the whole server and no cost per member.</p>
    </section>

    <Plans />
    <Compare />
    <Included />

    <section class="h-sec wrap" aria-labelledby="p-why-title">
      <h2 id="p-why-title">Why there's a paid plan.</h2>
      <div class="p-text">
        <p>Hosting one more server costs us very little. That's why Free is hosted by us and stays free, and why we will never switch the bot off to make you pay.</p>
        <p>What costs is everything around it: the machines, the database and its backups, and above all our time. New features, fixes, one update after another, and answers in the community. Premium pays for that work, and a single Premium server covers the hosting of many free ones.</p>
        <p>We're a small independent team. Premium is for the servers that need more, and it keeps TTM growing for everyone.</p>
      </div>
    </section>

    <section class="h-sec wrap" id="self-host" aria-labelledby="p-self-title">
      <h2 id="p-self-title">Rather run it yourself?</h2>
      <div class="p-text">
        <p>You can, with every Premium feature unlocked, at no cost and for good. The package will be on our <a class="h-link" href="/docs/community/">Discord server</a> shortly before the beta ends: you download it and run TTM on your own machine, and every update is published there.</p>
        <p>It covers you, your community or your own company. It doesn't cover offering TTM to others as a service, or passing the package on. The terms are in the <a class="h-link" href="/license/">self-hosting licence</a>, which you accept before you download it.</p>
        <div class="callout"><div class="callout-t">The honest maths</div>Self-hosting saves you €3 a month. For that, you pay for a server, keep a database running and backed up, update the bot by hand and fix it when it breaks at night. For €3 a month, under 10 cents a day, we do all of that for you.</div>
      </div>
    </section>

    <section class="h-sec wrap" id="founder" aria-labelledby="p-founder-title">
      <div class="p-fd">
        <p class="p-fd-tag">Founder · only during the beta</p>
        <h2 id="p-founder-title">Founder. Once, and never again.</h2>
        <p class="h-intro">A numbered badge for the servers that back TTM from the start, and the only way to get a full year of Premium at roughly half price. It exists only during the beta: once the beta ends, nobody can become a Founder again.</p>
        <ol class="p-fd-steps" role="list">
          {PASSI.map((p) => (
            <li>
              <h3>{p.titolo}</h3>
              <p>{p.testo}</p>
            </li>
          ))}
        </ol>
        <div class="p-fd-keep">
          <h3>What a Founder keeps</h3>
          <ul class="p-grid p-fd-perks" role="list">
            {VANTAGGI.map((v) => (
              <li>
                <span class="p-tick" aria-hidden="true">&#10003;</span>
                <h4>{v.titolo}</h4>
                <p>{v.testo}</p>
              </li>
            ))}
          </ul>
          <p class="p-fd-note">Nothing else is planned for Founders today. What we do promise is to give back to the servers that believed in us first.</p>
        </div>
        <p class="p-fd-last"><strong>No second round.</strong> Reservations open in the bot during the beta and close when it ends. The day they open is announced first on our <a class="h-link" href="/docs/community/">Discord server</a>.</p>
      </div>
    </section>

    <section class="h-sec wrap" aria-labelledby="p-questions-title">
      <h2 id="p-questions-title">Questions?</h2>
      <p class="h-intro">Ask us anything about plans, limits or self-hosting.</p>
      <p class="p-links"><a class="h-link" href="/docs/community/">Join the Discord</a> <a class="h-link" href="/docs/premium/">How the limits work</a></p>
    </section>
  </main>
</Base>
