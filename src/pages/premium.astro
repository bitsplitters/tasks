---
import Base from '../layouts/Base.astro';
import { docsCard } from '../lib/preview-card';
import { PAGINA_PIANI } from '../lib/pagina-piani';
import VetrinaFont from '../components/VetrinaFont.astro';
// vetrina.css prima di premium.css: le regole della pagina vengono dopo quelle comuni.
import '../styles/vetrina.css';
import '../styles/premium.css';
import Plans from '../components/premium/Plans.astro';
import Compare from '../components/premium/Compare.astro';
import Included from '../components/premium/Included.astro';
import FounderStato from '../components/FounderStato.astro';

// La pagina per scegliere un piano (spec docs/superpowers/specs/2026-11-14-pagina-premium-design.md, nel repo
// team-tasks-manager). Il riferimento tecnico dei limiti resta /docs/premium/; i prezzi stanno solo qui.
// Niente data-pagefind-body: la ricerca copre la documentazione, e questa pagina si trova dal menu, dalle barre
// laterali e dai rimandi. Nella cartella dist/premium/ stanno anche le immagini che il bot linka
// (/premium/premium-*.png): la pagina ci finisce accanto, e i loro indirizzi non cambiano.
const TITLE = `${PAGINA_PIANI.title} — Team Tasks Manager`;
const EMBED = docsCard(PAGINA_PIANI.title, PAGINA_PIANI.description, PAGINA_PIANI.path, 'See the plans');

// Il Founder (spec docs/superpowers/specs/2026-11-15-founder-design.md, §4): un evento a tempo, il prezzo in chiaro.
// Le cifre scritte (20 € contro 36 €, 1000 posti, 30 giorni) sono regole vere. Il numero del badge va ai primi 1000
// che comprano, non a chi lo sblocca soltanto (correzione dell'utente del 22/11, spec del Founder, regola 2): da qui
// «#0001 – #1000» sulla matrice del biglietto. Mille si scrive senza separatori, in ogni lingua: «1,000» confonde chi
// usa la virgola per i decimali, e il numero di un badge è un identificativo (utente, 22/11).
const PUNTI = [
  {
    titolo: 'Once, never again.',
    testo: 'Badges unlock in a limited window before the beta ends. When it closes, it never reopens.',
  },
  {
    titolo: 'Only 1000 numbers.',
    testo: "The first 1000 Founders who buy get the Founder price and a numbered badge, #1 to #1000. A reservation alone doesn't hold one.",
  },
  {
    titolo: 'Yours for good.',
    testo: "Missed the 1000? Buy at the standard price within 30 days and keep your Founder badge, without a number. Either way, it stays in the bot and on our Founders wall.",
  },
];
---
<Base title={TITLE} previewTitle={PAGINA_PIANI.title} description={PAGINA_PIANI.description} embed={EMBED}>
  <VetrinaFont slot="head" />
  <main class="vetrina">
    <section class="p-beta" aria-label="Open beta">
      <p class="wrap"><strong>Open beta.</strong> Every Premium feature is unlocked, for every server. Prices apply when the beta ends. <a class="h-link" href="/beta/">Why start now</a></p>
    </section>

    <section class="p-hero wrap">
      <h1><span>Start on Free.</span> <span>Grow into Premium.</span></h1>
      <p class="h-intro">Free covers a small team, and stays free. Premium lifts the limits for the servers that need more, with one price for the whole server and no cost per member.</p>
    </section>

    <Plans />
    <Compare />
    <Included />

    {/* Chi fa TTM (2026-11-21): risponde ai dubbi di chi è indeciso (posso fidarmi di un team piccolo? ci sarà ancora?
        chi mi risponde?) invece di giustificare il prezzo. Ogni affermazione dev'essere vera: le 15 versioni sono quelle
        delle note di rilascio dalla 1.0.0 (23/10) alla 2.4.1 (21/11). Chiusura sul Founder finché il programma è aperto;
        quando chiude, l'ultima frase diventa «Start on Free. If TTM earns its place in your server, Premium is there
        when you need more.» Un commento Astro e non HTML: non finisce nella pagina pubblicata. */}
    <section class="h-sec wrap" id="who" aria-labelledby="p-who-title">
      <h2 id="p-who-title">Made by people you can talk to.</h2>
      <div class="p-who">
        <div class="p-text">
          <p>Team Tasks Manager is made by <a class="h-link" href="https://bitsplitters.app">bitsplitters</a>, a small independent studio. We opened it to every Discord server because we believe teams work best where they already talk.</p>
          <p>Alex works on TTM full time, writing the code and answering on our <a class="h-link" href="/docs/community/">Discord server</a>. Your idea reaches the person who can build it.</p>
          <p>TTM gets better every week: 15 releases in under a month, all in the <a class="h-link" href="/docs/release-notes/">release notes</a>. Every update reaches every server, including those on the Free plan.</p>
          <p>Premium lifts the limits for the servers that need more, and it funds the next update for everyone. If you believe in TTM too, the <a class="h-link" href="#founder">Founder badge</a> is the best way to tell us.</p>
        </div>
        <figure class="p-who-card">
          <img src="/team/alex.jpg" alt="Portrait of Alex" width="256" height="256" loading="lazy" decoding="async" />
          <figcaption><strong>Alex</strong> <span>Developer and community manager</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="h-sec wrap" id="self-host" aria-labelledby="p-self-title">
      <h2 id="p-self-title">Rather run it yourself?</h2>
      <div class="p-text">
        <p>You can, with every Premium feature unlocked, at no cost and for good. The one thing it doesn't include is the Activity, which only the bot we host has. The package will be on our <a class="h-link" href="/docs/community/">Discord server</a> shortly before the beta ends: you download it and run TTM on your own machine, and every update is published there.</p>
        <p>It covers you, your community or your own company. It doesn't cover offering TTM to others as a service, or passing the package on. The terms are in the <a class="h-link" href="/license/">self-hosting licence</a>, which you accept before you download it.</p>
        <div class="callout"><div class="callout-t">The honest maths</div>Self-hosting saves you €3 a month. For that, you pay for a server, keep a database running and backed up, update the bot by hand and fix it when it breaks at night. For €3 a month <a class="h-link" href="#vat">before VAT</a>, under 10 cents a day, we do all of that for you.</div>
      </div>
    </section>

    <section class="h-sec wrap" id="founder" aria-labelledby="p-founder-title">
      <div class="p-fd">
        <p class="p-fd-band">
          <span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 22h14M5 2h14M17 22v-4.17a2 2 0 0 0-.59-1.42L12 12l-4.41 4.41A2 2 0 0 0 7 17.83V22M7 2v4.17a2 2 0 0 0 .59 1.42L12 12l4.41-4.41A2 2 0 0 0 17 6.17V2"/></svg> <strong>Limited-time event</strong> ·</span>
          <span>only before the beta ends</span>
        </p>
        <div class="p-fd-body">
          <div class="p-fd-head">
            <div>
              <h2 id="p-founder-title">Get your exclusive Founder badge.</h2>
              <p class="p-fd-status"><span class="p-fd-dot" aria-hidden="true"></span><span><FounderStato /></span></p>
              <p class="p-fd-lead">We love our community, and we want to reward the servers that believed in us first.</p>
            </div>
            <div class="p-fd-price">
              <div class="p-fd-tk-main">
              <p class="p-fd-price-t">Founder price</p>
              <p class="p-fd-amount"><span class="p-fd-now">€20</span><span class="p-fd-per">/year <a class="p-vat" href="#vat">+ VAT</a></span> <span class="p-fd-sconto"><s class="p-fd-was"><span class="sr-only">instead of </span>€36</s> <span class="p-fd-off">&minus;44%</span></span></p>
              <p class="p-fd-price-note">A full year of Premium, for Founders only.</p>
              </div>
              <p class="p-fd-tk-stub"><span class="p-fd-tk-lab">Founder badge</span> <span class="p-fd-tk-no">#0001<span aria-hidden="true"> – </span><span class="sr-only"> to </span>#1000</span></p>
            </div>
          </div>
          <ul class="p-fd-tiles" role="list">
            {PUNTI.map((p) => (
              <li>
                <h3>{p.titolo}</h3>
                <p>{p.testo}</p>
              </li>
            ))}
          </ul>
          <p class="p-fd-fine">No badge, no Founder price. When Premium opens, Founders have 30 days to buy, at €20 while spots last or at the standard price, and keep their badge. No other Founder perks are planned today.</p>
        </div>
      </div>
    </section>

    <section class="h-sec wrap" aria-labelledby="p-questions-title">
      <h2 id="p-questions-title">Questions?</h2>
      <p class="h-intro">Ask us anything about plans, limits or self-hosting.</p>
      <p class="p-links"><a class="h-link" href="/docs/community/">Join the Discord</a> <a class="h-link" href="/docs/premium/">How the limits work</a></p>
    </section>
  </main>
</Base>
