---
// I casi d'uso in inglese; il contenuto sta in src/pagine/PaginaCaso.astro.
import { getCollection } from 'astro:content';
import PaginaCaso from '../../pagine/PaginaCaso.astro';

export async function getStaticPaths() {
  return (await getCollection('useCases')).map((entry) => ({ params: { slug: entry.id }, props: { id: entry.id } }));
}

const { id } = Astro.props;
---
<PaginaCaso lingua="en" id={id} />
