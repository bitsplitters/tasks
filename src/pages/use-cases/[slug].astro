---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import VetrinaFont from '../../components/VetrinaFont.astro';
import { docsCard } from '../../lib/preview-card';
import { giornoEOra, htmlDellaLista, riproduzione } from '../../lib/esempi/discord';
import { legenda } from '../../lib/esempi/legenda';
import { coiNomi } from '../../lib/esempi/testo';
import { prosa, prosaInLinea } from '../../lib/esempi/prosa';
import type { Esempio } from '../../lib/esempi/tipi';
// docs.css per la prosa; scene.css per i pezzi di Discord (le classi sc-*, con le misure di Discord); poi le regole dei
// casi d'uso.
import '../../styles/docs.css';
import '../../components/home/scene.css';
import '../../styles/use-cases.css';

// Un caso d'uso (spec 2026-11-20-casi-d-uso-esempi-completi-design.md, §3, nel repo team-tasks-manager): la storia di
// un team che usa TTM per una settimana. L'attacco; il team; la lista com'è su Discord; il testo di Bulk update coi nomi
// del team (segnaposto leggibili, 2.5.0), con la legenda di ciò che usa; la configurazione e i webhook; la settimana, coi momenti chiave riprodotti; poi il corpo
// Markdown (la prossima volta, cosa TTM non fa, le domande), gli altri casi e l'invito. Tutto HTML statico: le
// riproduzioni le scrive al build il motore della demo della home (src/lib/esempi/discord.ts).
export async function getStaticPaths() {
  const casi = await getCollection('useCases');
  return casi.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const altri = (await getCollection('useCases'))
  .filter((c) => c.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order);
const d = entry.data;
const esempio: Esempio = d;
const { team } = d;

const intro = await prosa(d.intro);
const look = await prosa(d.list.look);
const canaleDellaLista = team.channels.find((c) => c.id === d.list.channel)!.name;
const nomeDi = (id: string) => team.people.find((p) => p.id === id)?.name ?? '';
const impostazioni = await Promise.all(d.settings.map(async (s) => ({ ...s, why: await prosaInLinea(s.why) })));
// L'ancora della sezione di /docs/configuration/ col nome dell'impostazione: «Keep the state after a selection».
const ancora = (nome: string) => nome.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const SERVIZIO = { discord: 'In Discord', github: 'In GitHub', make: 'In Make' } as const;
const webhook = await Promise.all(d.webhooks.map(async (w) => ({
  ...w,
  setup: await prosa(w.setup),
  comando: `/config webhook action:create webhook:${w.name}${w.trigger === 'completion' ? ' trigger:completion' : ''}`,
})));
const settimana = await Promise.all(d.week.map(async (m) => ({
  quando: giornoEOra(m.at, team.zone),
  giorno: m.at.slice(0, 10),
  testo: await prosa(m.text),
  scheda: riproduzione(esempio, m),
})));
// Un giorno nuovo apre un blocco della linea del tempo: la settimana si legge per giorni.
const giorni = settimana.map((m, i) => i === 0 || settimana[i - 1].giorno !== m.giorno);
const premium = d.webhooks.length > 0 || d.settings.some((s) => s.premium) || team.roles.some((r) => r.ttm);
---
<Base title={`${d.seoTitle} — Team Tasks Manager`} previewTitle={d.title} description={d.description} embed={docsCard('en', d.title, d.description, Astro.url.pathname, 'See the example')}>
  <VetrinaFont slot="head" />
  <main class="docs-main">
    <article class="prose uc wrap">
      <p class="uc-crumb"><a href="/use-cases/">Use cases</a></p>
      <h1>{d.title}</h1>
      <p class="subtitle">{d.description}</p>
      <Fragment set:html={intro} />

      <h2 id="the-team">The team</h2>
      <div class="ex-team">
        <section aria-labelledby="ex-people">
          <h3 id="ex-people">People</h3>
          <ul role="list">
            {team.people.map((p) => (
              <li><span class="ex-who"><span class="ex-dot" style={`background:${p.color}`} aria-hidden="true">{p.name.slice(0, 1)}</span>{p.name}</span><span class="ex-about">{p.about}</span></li>
            ))}
          </ul>
        </section>
        <section aria-labelledby="ex-roles">
          <h3 id="ex-roles">Roles</h3>
          <ul role="list">
            {team.roles.map((r) => (
              <li>
                <span class="ex-who"><span class="ex-role">@{r.name}</span>{r.ttm && <a class="premium-tag" href="/premium/" title="Unlocked for every server during the beta">Premium</a>}</span>
                <span class="ex-about">{r.about}{r.members && ` Members: ${r.members.map(nomeDi).join(' and ')}.`}</span>
              </li>
            ))}
          </ul>
        </section>
        <section aria-labelledby="ex-channels">
          <h3 id="ex-channels">Channels</h3>
          <ul role="list">
            {team.channels.map((c) => (
              <li><span class="ex-who"><span class="ex-chan" aria-hidden="true">{c.voice ? '🔊' : '#'}</span>{c.name}</span><span class="ex-about">{c.about}</span></li>
            ))}
          </ul>
        </section>
      </div>
      <p class="ex-note">The times on this page are in the team's time zone, <code>{team.zone}</code>. Discord shows every date in the time zone of whoever reads it.</p>

      <h2 id="the-list">The list on Discord</h2>
      <p class="ex-cap">In #{canaleDellaLista}, on {giornoEOra(d.list.at, team.zone)}.</p>
      <div class="ex-dc">
        <Fragment set:html={htmlDellaLista(esempio)} />
      </div>
      <Fragment set:html={look} />

      <h2 id="the-text">The text behind it</h2>
      <p>This is what <strong>Bulk update</strong> <img class="inline-ic" src="/icons/edit.png" alt="" /> shows for the list, with the dates in the team's time zone. The buttons write it for you. You can also type it, or write a text like this in <code>/create-list</code> with your own server's people, roles and channels.</p>
      <pre class="ex-text" translate="no"><code>{coiNomi(d.list.text, team)}</code></pre>
      <dl class="ex-legend">
        {legenda(d.list.text).map((v) => (
          <div>
            <dt><code translate="no">{v.codice}</code></dt>
            <dd><Fragment set:html={v.spiega} /> <a href={v.link}>More</a></dd>
          </div>
        ))}
      </dl>

      <h2 id="the-setup">How it's set up</h2>
      {premium && <p class="ex-note">Webhooks, recurring reminders and owners of several people are <a href="/premium/">Premium</a> features, unlocked for every server during the beta.</p>}
      <p>The choices this team made in <a href="/docs/configuration/"><code>/config app</code></a>, and why.</p>
      <div class="ex-table">
        <table>
          <thead><tr><th scope="col">Setting</th><th scope="col">Choice</th><th scope="col">Why</th></tr></thead>
          <tbody>
            {impostazioni.map((s) => (
              <tr>
                <th scope="row"><a href={`/docs/configuration/#${ancora(s.setting)}`}>{s.setting}</a>{s.premium && <> <a class="premium-tag" href="/premium/" title="Unlocked for every server during the beta">Premium</a></>}</th>
                <td>{s.choice}</td>
                <td><Fragment set:html={s.why} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {webhook.map((w, i) => (
        <section class="ex-wh" aria-labelledby={`ex-wh-${i}`}>
          <h3 id={`ex-wh-${i}`}>The webhook «{w.name}» <a class="premium-tag" href="/premium/" title="Unlocked for every server during the beta">Premium</a></h3>
          <p>Created with this command, then linked to its task with <strong>Webhook</strong> <img class="inline-ic" src="/icons/api.png" alt="" />. {w.trigger === 'completion' ? 'With the trigger, it fires only when the task is completed.' : 'Without a trigger, it fires when the task is completed and when it is reopened.'}</p>
          <pre translate="no"><code>{w.comando}</code></pre>
          <dl class="ex-form">
            <div><dt>HTTP method</dt><dd><code translate="no">{w.method}</code></dd></div>
            <div><dt>URL</dt><dd><code translate="no">{w.url}</code></dd></div>
            <div><dt>Headers</dt><dd><pre translate="no"><code>{w.headers.trim()}</code></pre></dd></div>
            <div><dt>Body</dt><dd><pre translate="no"><code>{w.body.trim()}</code></pre></dd></div>
          </dl>
          <h4>{SERVIZIO[w.service]}</h4>
          <Fragment set:html={w.setup} />
        </section>
      ))}

      <h2 id="the-week">How the week went</h2>
      <ol class="ex-week" role="list">
        {settimana.map((m, i) => (
          <li data-day={giorni[i] ? '' : undefined}>
            <p class="ex-when"><time datetime={d.week[i].at}>{m.quando}</time></p>
            <div class="ex-what">
              <Fragment set:html={m.testo} />
              {m.scheda && (
                <figure class="ex-card">
                  <figcaption>{m.scheda.dove}</figcaption>
                  <div class="ex-dc"><Fragment set:html={m.scheda.html} /></div>
                </figure>
              )}
            </div>
          </li>
        ))}
      </ol>

      <Content />

      <section class="uc-more" aria-labelledby="uc-more-t">
        <h2 id="uc-more-t">Other use cases</h2>
        <ul class="d-list uc-list" role="list">
          {altri.map((c) => (
            <li>
              <a href={`/use-cases/${c.id}/`}>
                <span class="d-t">{c.data.name}</span>
                <span class="d-d">{c.data.highlights}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
      <section class="uc-final" aria-labelledby="uc-final-t">
        <h2 id="uc-final-t">Add TTM to your server</h2>
        <p>Then run <code>/create-list</code> and write your team's first list.</p>
        <div class="cta-row">
          <a class="btn" href="/invite">Add to Discord</a>
          <a class="btn-ghost" href="/docs/getting-started/">Get started</a>
        </div>
      </section>
    </article>
  </main>
</Base>
