---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { docsCard } from '../../lib/preview-card';
import { PAGINA_PIANI } from '../../lib/pagina-piani';
import { GRUPPI_DOCS, POSTI } from '../../lib/gruppi-docs';

// Il sottotitolo serve due volte: sotto il titolo della pagina e come descrizione dell'anteprima.
const SUBTITLE = 'Everything you need to run Team Tasks Manager on your Discord server.';

const all = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const grouped = GRUPPI_DOCS
  .map((g) => ({ ...g, items: all.filter((d) => d.data.group === g.name) }))
  .filter((g) => g.items.length);
---
<Base title="Documentation — Team Tasks Manager" description={SUBTITLE} card="large" embed={docsCard('Documentation', SUBTITLE, '/docs/', 'Browse the docs')}>
  <div class="docs-shell">
    <aside class="docs-side">
      {grouped.map((g) => (
        <div>
          <div class={g.place ? `grp grp-place is-${g.place}` : 'grp'}>
            {g.place && <img class="place-ic" src={POSTI[g.place].icon} alt="" />}{g.name}
          </div>
          {g.items.map((it) => (
            <a href={`/docs/${it.id}/`}>{it.data.title}</a>
          ))}
          {/* La pagina dei piani sta fuori dalla collezione docs: in fondo al gruppo Plans. */}
          {g.name === 'Plans' && <a href={PAGINA_PIANI.path}>{PAGINA_PIANI.title}</a>}
        </div>
      ))}
    </aside>
    <article class="prose">
      <h1>Documentation</h1>
      <p class="subtitle">{SUBTITLE}</p>
      {grouped.map((g) => (
        <div>
          <h2 class={g.place ? `h-place is-${g.place}` : undefined}>
            {g.place && <img class="place-ic" src={POSTI[g.place].icon} alt="" />}{g.name}
          </h2>
          {g.intro && <p class="grp-intro">{g.intro}</p>}
          {g.items.map((it) => (
            <p><a href={`/docs/${it.id}/`}><strong>{it.data.title}</strong></a>{it.data.description ? ' — ' + it.data.description : ''}</p>
          ))}
          {g.name === 'Plans' && (
            <p><a href={PAGINA_PIANI.path}><strong>{PAGINA_PIANI.title}</strong></a>{' — ' + PAGINA_PIANI.description}</p>
          )}
        </div>
      ))}
    </article>
  </div>
</Base>
