---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const all = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const groupsOrder = ['Start', 'Using the bot', 'More'];
const grouped = groupsOrder
  .map((g) => ({ name: g, items: all.filter((d) => d.data.group === g) }))
  .filter((g) => g.items.length);
---
<Base title="Documentation — Team Tasks Manager">
  <div class="docs-shell">
    <aside class="docs-side">
      {grouped.map((g) => (
        <div>
          <div class="grp">{g.name}</div>
          {g.items.map((it) => (
            <a href={`/docs/${it.slug}/`}>{it.data.title}</a>
          ))}
        </div>
      ))}
    </aside>
    <article class="prose">
      <h1>Documentation</h1>
      <p class="subtitle">Everything you need to run Team Tasks Manager on your Discord server.</p>
      {grouped.map((g) => (
        <div>
          <h2>{g.name}</h2>
          {g.items.map((it) => (
            <p><a href={`/docs/${it.slug}/`}><strong>{it.data.title}</strong></a>{it.data.description ? ' — ' + it.data.description : ''}</p>
          ))}
        </div>
      ))}
    </article>
  </div>
</Base>
