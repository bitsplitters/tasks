---
// Le pagine della documentazione in inglese; il contenuto sta in src/pagine/PaginaDocs.astro.
//
// `entry.id` e non `entry.slug`: dal Content Layer le entry sono oggetti serializzabili e non portano piu' metodi. Il
// NOME del parametro di rotta resta `slug` — e' indipendente dal campo della entry, quindi il file [...slug].astro non
// si rinomina.
import { getCollection } from 'astro:content';
import PaginaDocs from '../../pagine/PaginaDocs.astro';

export async function getStaticPaths() {
  return (await getCollection('docs')).map((entry) => ({ params: { slug: entry.id }, props: { id: entry.id } }));
}

const { id } = Astro.props;
---
<PaginaDocs lingua="en" id={id} />
