---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import VetrinaFont from '../../components/VetrinaFont.astro';
import DocsSearch from '../../components/DocsSearch.astro';
import { docsCard } from '../../lib/preview-card';
import { PAGINA_PIANI } from '../../lib/pagina-piani';
import { GRUPPI_DOCS, POSTI } from '../../lib/gruppi-docs';
// docs.css dopo Base, che importa global.css: le regole della documentazione vengono dopo quelle comuni.
import '../../styles/docs.css';

// `entry.id` e non `entry.slug`, `render(entry)` e non `entry.render()`: dal Content Layer le entry
// sono oggetti serializzabili e non portano piu' metodi. Il NOME del parametro di rotta resta
// `slug` — e' indipendente dal campo della entry, quindi il file [...slug].astro non si rinomina.
export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const all = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const grouped = GRUPPI_DOCS
  .map((g) => ({ ...g, items: all.filter((d) => d.data.group === g.name) }))
  .filter((g) => g.items.length);
const current = entry.id;
const posto = entry.data.place ? POSTI[entry.data.place] : null;
---
<Base title={entry.data.title + " — Team Tasks Manager docs"} previewTitle={entry.data.title} description={entry.data.description} embed={docsCard(entry.data.title, entry.data.description, Astro.url.pathname)}>
  <VetrinaFont slot="head" />
  {/* Il <main> dà a chi usa uno screen reader un punto di arrivo per il contenuto, come nelle pagine della vetrina.
      Porta il carattere: il menu in alto e il piè di pagina restano in mono. */}
  <main class="docs-main">
    <button
      class="docs-menu-toggle" id="docs-menu-toggle" aria-label="Open documentation menu"
    >&#9776; Documentation</button>
    <div class="docs-shell">
      <aside class="docs-side" id="docs-side">
        <button class="docs-side-close" id="docs-side-close" aria-label="Close menu">&times;</button>
        <DocsSearch />
        {grouped.map((g) => (
          <div>
            <div class={g.place ? `grp grp-place is-${g.place}` : 'grp'}>
              {g.place && <img class="place-ic" src={POSTI[g.place].icon} alt="" />}{g.name}
            </div>
            {g.items.map((it) => (
              <a href={`/docs/${it.id}/`} class={it.id === current ? 'active' : ''}>{it.data.title}</a>
            ))}
            {/* La pagina dei piani sta fuori dalla collezione docs: in fondo al gruppo Plans, mai `active`. */}
            {g.name === 'Plans' && <a href={PAGINA_PIANI.path}>{PAGINA_PIANI.title}</a>}
          </div>
        ))}
      </aside>
      {/* data-pagefind-body delimita CIO' CHE VA INDICIZZATO. Senza, Pagefind indicizza tutta la
          pagina, sidebar compresa: ogni voce del menu comparirebbe in ogni pagina e una ricerca per
          «webhook» restituirebbe tutte le pagine del sito. Effetto collaterale voluto: appena un
          attributo del genere esiste, Pagefind indicizza SOLO le pagine che lo hanno, quindi la
          ricerca copre la documentazione e non le pagine legali. */}
      <article class="prose" data-pagefind-body>
        {/* La pillola del posto sta sopra il titolo: si legge prima di tutto il resto. Dice di quale dei due posti
            parlano i pulsanti della pagina. */}
        {posto && (
          <p class={`place-pill is-${entry.data.place}`}>
            <img class="place-ic" src={posto.icon} alt="" />{posto.label}
          </p>
        )}
        <h1>{entry.data.title}</h1>
        {entry.data.description && <p class="subtitle">{entry.data.description}</p>}
        <Content />
      </article>
    </div>
  </main>
  <script>
    const t = document.getElementById("docs-menu-toggle");
    const s = document.getElementById("docs-side");
    const c = document.getElementById("docs-side-close");

    // La classe sul body blocca lo scroll della pagina mentre il menu e' aperto: senza, il gesto
    // che "manca" il pannello scorre il contenuto dietro invece del menu. Va togliuta in OGNI
    // uscita — croce, tap fuori, Escape, e anche la navigazione verso una voce — altrimenti la
    // pagina di destinazione resta bloccata e sembra rotta.
    const apri = () => { s.classList.add("open"); document.body.classList.add("docs-menu-open"); };
    const chiudi = () => { s.classList.remove("open"); document.body.classList.remove("docs-menu-open"); };

    if (t && s) t.addEventListener("click", apri);
    if (c && s) c.addEventListener("click", chiudi);
    if (s) s.addEventListener("click", (e) => { if (e.target === s) chiudi(); });
    if (s) s.addEventListener("click", (e) => { if (e.target.closest("a")) chiudi(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && s && s.classList.contains("open")) chiudi(); });
  </script>
</Base>
