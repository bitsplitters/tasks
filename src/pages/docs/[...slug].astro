---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import VetrinaFont from '../../components/VetrinaFont.astro';
import DocsSearch from '../../components/DocsSearch.astro';
import AperturaNoteDiRilascio from '../../components/AperturaNoteDiRilascio.astro';
import { docsCard } from '../../lib/preview-card';
import { PAGINA_PIANI } from '../../lib/pagina-piani';
import { GRUPPI_DOCS, POSTI } from '../../lib/gruppi-docs';
// docs.css dopo Base, che importa global.css: le regole della documentazione vengono dopo quelle comuni.
import '../../styles/docs.css';

// `entry.id` e non `entry.slug`, `render(entry)` e non `entry.render()`: dal Content Layer le entry
// sono oggetti serializzabili e non portano piu' metodi. Il NOME del parametro di rotta resta
// `slug` — e' indipendente dal campo della entry, quindi il file [...slug].astro non si rinomina.
export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const all = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const grouped = GRUPPI_DOCS
  .map((g) => ({ ...g, items: all.filter((d) => d.data.group === g.name) }))
  .filter((g) => g.items.length);
const current = entry.id;
const posto = entry.data.place ? POSTI[entry.data.place] : null;
---
<Base title={entry.data.title + " — Team Tasks Manager docs"} previewTitle={entry.data.title} description={entry.data.description} embed={docsCard(entry.data.title, entry.data.description, Astro.url.pathname)}>
  <VetrinaFont slot="head" />
  {/* Il <main> dà a chi usa uno screen reader un punto di arrivo per il contenuto, come nelle pagine della vetrina.
      Porta il carattere: il menu in alto e il piè di pagina restano in mono. */}
  <main class="docs-main">
    <button
      class="docs-menu-toggle" id="docs-menu-toggle" aria-label="Open documentation menu"
      aria-expanded="false" aria-controls="docs-side"
    >&#9776; Documentation</button>
    <div class="docs-shell">
      <aside class="docs-side" id="docs-side">
        {/* La prima riga del pannello del telefono: la croce, a destra. Lo switch del tema stava a sinistra (spec
            2026-11-19-tema-chiaro-sito-design.md, §6.3, nel repo team-tasks-manager); dal 2026-11-19 sta solo
            nell'intestazione. Sopra gli 820 px la riga è nascosta. */}
        <div class="docs-side-top">
          <button class="docs-side-close" id="docs-side-close" aria-label="Close menu">&times;</button>
        </div>
        <DocsSearch />
        {/* L'indice della documentazione: prima voce, sopra i gruppi, così da ogni pagina si torna all'elenco. */}
        <a href="/docs/" class="side-overview">Overview</a>
        {grouped.map((g) => (
          <div>
            <div class={g.place ? `grp grp-place is-${g.place}` : 'grp'}>
              {g.place && <img class="place-ic" src={POSTI[g.place].icon} alt="" />}{g.name}
            </div>
            {g.items.map((it) => (
              <a href={`/docs/${it.id}/`} class={it.id === current ? 'active' : ''}
                aria-current={it.id === current ? 'page' : undefined}>{it.data.title}</a>
            ))}
            {/* La pagina dei piani sta fuori dalla collezione docs: in fondo al gruppo Plans, mai `active`. */}
            {g.name === 'Plans' && <a href={PAGINA_PIANI.path}>{PAGINA_PIANI.title}</a>}
          </div>
        ))}
      </aside>
      {/* data-pagefind-body delimita CIO' CHE VA INDICIZZATO. Senza, Pagefind indicizza tutta la
          pagina, sidebar compresa: ogni voce del menu comparirebbe in ogni pagina e una ricerca per
          «webhook» restituirebbe tutte le pagine del sito. Effetto collaterale voluto: appena un
          attributo del genere esiste, Pagefind indicizza SOLO le pagine che lo hanno, quindi la
          ricerca copre la documentazione e non le pagine legali. */}
      <article class="prose" data-pagefind-body>
        {/* La pillola del posto sta sopra il titolo: si legge prima di tutto il resto. Dice di quale dei due posti
            parlano i pulsanti della pagina. */}
        {posto && (
          <p class={`place-pill is-${entry.data.place}`}>
            <img class="place-ic" src={posto.icon} alt="" />{posto.label}
          </p>
        )}
        <h1>{entry.data.title}</h1>
        {entry.data.description && <p class="subtitle">{entry.data.description}</p>}
        <Content />
      </article>
      {entry.data.releases && <AperturaNoteDiRilascio />}
    </div>
  </main>
  <script>
    // Il menu della documentazione sul telefono (spec 2026-11-16-restyle-documentazione-design.md, §3.6 e §6, nel
    // repo team-tasks-manager).
    const toggle = document.getElementById('docs-menu-toggle');
    const side = document.getElementById('docs-side');
    const close = document.getElementById('docs-side-close');
    // La prima riga del pannello: a sinistra della croce è spazio vuoto, e un tocco lì chiude come un tocco sul resto
    // del pannello fuori dalle voci.
    const riga = side?.querySelector('.docs-side-top');

    // Il resto della pagina, che a menu aperto prende `inert`: il Tab resta nel pannello, uno screen reader non legge
    // quello che il pannello copre.
    const fuori = () =>
      document.querySelectorAll<HTMLElement>('.site-top, .site-nav, #docs-menu-toggle, .docs-shell > article, .site-foot');

    // La voce della pagina aperta, portata in vista dentro la barra laterale o il pannello. Scorre la barra, mai la
    // pagina: scrollIntoView muoverebbe anche la finestra.
    const voceApertaInVista = () => {
      const voce = side?.querySelector('a.active');
      if (!side || !voce) return;
      const barra = side.getBoundingClientRect();
      const v = voce.getBoundingClientRect();
      const alto = Math.max(barra.top, 0);
      const basso = Math.min(barra.bottom, window.innerHeight);
      if (v.top >= alto && v.bottom <= basso) return;
      side.scrollTop += v.top - alto - (basso - alto - v.height) / 2;
    };

    if (toggle && side && close) {
      const apri = () => {
        side.classList.add('open');
        // Su html, che passa il suo overflow alla finestra: su body il blocco non bloccherebbe niente.
        document.documentElement.classList.add('docs-menu-open');
        toggle.setAttribute('aria-expanded', 'true');
        fuori().forEach((el) => { el.inert = true; });
        voceApertaInVista();
        // Senza scorrere: il pannello resta sulla voce aperta, la croce è già in vista.
        close.focus({ preventScroll: true });
      };
      // Ogni uscita passa da qui: la croce, un tocco fuori dalle voci, Escape, una voce, la finestra che si allarga.
      // Altrimenti la pagina resterebbe bloccata. Il fuoco torna al pulsante, tranne quando si va a un'altra pagina o
      // il pulsante sparisce.
      const chiudi = (restituisci: boolean) => {
        if (!side.classList.contains('open')) return;
        side.classList.remove('open');
        document.documentElement.classList.remove('docs-menu-open');
        toggle.setAttribute('aria-expanded', 'false');
        fuori().forEach((el) => { el.inert = false; });
        if (restituisci) toggle.focus();
      };
      toggle.addEventListener('click', apri);
      close.addEventListener('click', () => chiudi(true));
      side.addEventListener('click', (e) => {
        if (e.target === side || e.target === riga) chiudi(true);
        else if (e.target instanceof Element && e.target.closest('a')) chiudi(false);
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') chiudi(true); });
      window.matchMedia('(max-width: 820px)').addEventListener('change', (e) => { if (!e.matches) chiudi(false); });
    }
    voceApertaInVista();
    // Mona Sans arriva dopo questo script: col carattere di riserva una voce lunga sta su una riga invece di due, la
    // barra è più corta e lo scorrimento si ferma prima. A caratteri pronti si rifà il conto, se nessuno ha mosso la
    // barra nel frattempo.
    const scorsaA = side?.scrollTop;
    document.fonts.ready.then(() => { if (side?.scrollTop === scorsaA) voceApertaInVista(); });
  </script>
</Base>
