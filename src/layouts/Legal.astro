---
import Base from './Base.astro';
import VetrinaFont from '../components/VetrinaFont.astro';
// docs.css dopo Base, che importa global.css: le regole della documentazione vengono dopo quelle comuni.
import '../styles/docs.css';
// La lingua la ricava Base dal percorso (/it/terms/). Il collegamento «Leggi questa pagina in italiano» non c'è più:
// il selettore e il piè di pagina portano alla stessa pagina in ogni lingua (spec 2026-11-19-sito-multilingua-design.md,
// §4.3 e §16, nel repo team-tasks-manager).
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title + " — bitsplitters"} description={frontmatter.description}>
  <VetrinaFont slot="head" />
  <main class="docs-main">
    <div class="legal-page">
      <article class="prose">
        <h1>{frontmatter.title}</h1>
        <p class="subtitle">{frontmatter.updated}</p>
        <slot />
      </article>
    </div>
  </main>
</Base>
