---
import '../styles/global.css';
export interface Props { title: string; description?: string; lang?: 'en' | 'it'; }
const { title, description = "Team Tasks Manager brings task coordination inside Discord: shared checklists, reminders and roles, without leaving your server.", lang = 'en' } = Astro.props;
// Solo le pagine legali esistono anche in italiano (Codice del consumo, art. 9): il footer di una
// pagina italiana punta alle copie italiane, quello delle altre alle inglesi.
const it = lang === 'it';
const legali = it
  ? [['/it/terms/', 'Termini'], ['/it/privacy/', 'Privacy'], ['/it/gdpr/', 'GDPR'], ['/it/license/', 'Licenza']]
  : [['/terms/', 'Terms'], ['/privacy/', 'Privacy'], ['/gdpr/', 'GDPR'], ['/license/', 'Licence']];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
  <header class="site-top">
    <div class="mark">
      <a class="brand" href="https://bitsplitters.app" aria-label="bitsplitters home">bit<span class="bar"></span>splitters</a>
      <span class="sep">/</span>
      <a class="prod" href="/">tasks</a>
    </div>
    <nav>
      <a href="/docs/">Docs</a>
      <a href="/docs/beta/">Beta</a>
      <a href="/docs/release-notes/" class="nav-wide">Release notes</a>
      <a href="/docs/troubleshooting/">Help</a>
    </nav>
  </header>
  <slot />
  <footer class="site-foot">
    <div class="wrap foot-inner">
      <span>&copy; 2026 <a href="https://bitsplitters.app">bitsplitters</a> &middot; Team Tasks Manager</span>
      <nav class="foot-links">
        {legali.map(([href, testo]) => <a href={href}>{testo}</a>)}
        {it ? <a href="/terms/" lang="en">English</a> : <a href="/it/terms/" lang="it">Italiano</a>}
        <a href="mailto:info@bitsplitters.app">info@bitsplitters.app</a>
      </nav>
    </div>
  </footer>
</body>
</html>
