---
import '../styles/global.css';
import PreviewMeta from '../components/PreviewMeta.astro';
import Analytics from '../components/Analytics.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
// `previewTitle`: il titolo della scheda di anteprima, quando quello della pagina porta gia' il nome
// del sito, che la scheda mostra a parte (og:site_name). `card` ed `embed`: vedi PreviewMeta.
export interface Props { title: string; description?: string; lang?: 'en' | 'it'; card?: 'large' | 'small'; previewTitle?: string; embed?: Record<string, unknown>; }
const { title, description, lang = 'en', card, previewTitle, embed } = Astro.props;
// Solo le pagine legali esistono anche in italiano (Codice del consumo, art. 9): il footer di una
// pagina italiana punta alle copie italiane, quello delle altre alle inglesi.
const it = lang === 'it';
const legali = it
  ? [['/it/terms/', 'Termini'], ['/it/privacy/', 'Privacy'], ['/it/gdpr/', 'GDPR'], ['/it/license/', 'Licenza']]
  : [['/terms/', 'Terms'], ['/privacy/', 'Privacy'], ['/gdpr/', 'GDPR'], ['/license/', 'Licence']];
// L'indirizzo canonico, lo stesso di og:url (PreviewMeta): senza query string, quindi un link con un
// parametro (per esempio quello che dice da quale canale arriva chi legge) non diventa per Google una
// seconda copia della pagina. /invite non passa da qui: ha il suo canonical, sull'URL OAuth2.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {/* Il tema, prima del primo disegno (spec 2026-11-19-tema-chiaro-sito-design.md, §3.2, nel repo
      team-tasks-manager): lo scuro, tranne per chi ha scelto il chiaro con lo switch. Inline e in testa, perche'
      un modulo arriverebbe dopo il disegno col lampo del tema sbagliato. Il tema del dispositivo non conta. Senza
      JavaScript data-theme manca e vale lo scuro di :root. */}
  <script is:inline>
    try { document.documentElement.dataset.theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark'; }
    catch { document.documentElement.dataset.theme = 'dark'; }
  </script>
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <PreviewMeta title={previewTitle ?? title} description={description} card={card} embed={embed} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <slot name="head" />
</head>
<body>
  <header class="site-top">
    <div class="mark">
      <a class="brand" href="https://bitsplitters.app" aria-label="bitsplitters home">bit<span class="bar"></span>splitters</a>
      <span class="sep">/</span>
      <a class="prod" href="/">tasks</a>
    </div>
    {/* Niente «Help» (utente, 2026-11-19): puntava alla risoluzione dei problemi, mentre chi cerca aiuto può voler
        scrivere allo staff. Il gruppo «Help & community» della documentazione ha l'una e l'altra cosa. Fino a 640 px
        Docs e Premium sono solo icone, le stesse dei pulsanti del bot (libro e diamante): il nome resta per gli
        screen reader. */}
    <nav>
      <a href="/docs/" class="nav-ic-link">
        <svg class="nav-ic" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 7v14" />
          <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" />
        </svg><span class="nav-txt">Docs</span></a>
      <a href="/premium/" class="nav-ic-link">
        <svg class="nav-ic" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 3h12l4 6-10 13L2 9Z" />
          <path d="M11 3 8 9l4 13 4-13-3-6" />
          <path d="M2 9h20" />
        </svg><span class="nav-txt">Premium</span></a>
      <a href="/beta/" class="nav-wide">Beta</a>
      <a href="/docs/release-notes/" class="nav-wide">Release notes</a>
    </nav>
    {/* Gli strumenti della pagina: lo switch del tema, poi il selettore della lingua (spec
        2026-11-19-tema-chiaro-sito-design.md, §6.3 e §10). Stanno nell'intestazione a ogni larghezza (utente,
        2026-11-19): lo switch non è più nel menu della documentazione né nel pie' di pagina. */}
    <div class="site-tools"><ThemeToggle lang={lang} /></div>
  </header>
  <slot />
  <footer class="site-foot">
    <div class="wrap foot-inner">
      {/* Il badge e' il prezzo della scheda gratuita su Fazier, che lo cerca nel sito: si tiene. L'immagine
          e' una copia locale (lo consente la loro guida), cosi' la pagina non chiama fazier.com. */}
      <div class="foot-left">
        <span>&copy; 2026 <a href="https://bitsplitters.app">bitsplitters</a> &middot; Team Tasks Manager</span>
        <a class="foot-badge" href="https://fazier.com/launches/tasks.bitsplitters.app"><img src="/badges/fazier.svg" alt="Fazier badge" width="120" height="51" /></a>
      </div>
      <nav class="foot-links">
        {legali.map(([href, testo]) => <a href={href}>{testo}</a>)}
        {it ? <a href="/terms/" lang="en">English</a> : <a href="/it/terms/" lang="it">Italiano</a>}
        <a href="mailto:info@bitsplitters.app">info@bitsplitters.app</a>
      </nav>
    </div>
  </footer>
  <Analytics />
</body>
</html>
