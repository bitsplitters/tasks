---
/*
 * La lista pronta di un caso d'uso (spec 2026-11-20-casi-d-uso-sito-design.md, §5, nel repo team-tasks-manager).
 *
 * La finestra di /create-list com'è su Discord: il suo titolo e i suoi due campi, con i loro nomi veri
 * (tasklist.modal.create.* in slash-resource.properties), così chi legge incolla ogni parte nel campo che ha lo
 * stesso nome. È una riproduzione di Discord, quindi resta scura nei due temi (README, «Colors»).
 *
 * I pulsanti Copy nascono nascosti e li mostra lo script, solo dove gli appunti esistono: senza JavaScript il testo
 * resta leggibile e si seleziona a mano. Il file è lo stesso formato del Download, e /create-list lo importa.
 */
import { nomeFile, quantiTask } from '../../lib/lista-pronta';

interface Props { slug: string; listTitle: string; list: string; }
const { slug, listTitle, list } = Astro.props;
const n = quantiTask(list);
---
<section class="uc-ready" aria-labelledby="uc-ready-t">
  <h2 id="uc-ready-t">The list, ready to paste</h2>
  <p>{n} tasks, subtasks included. Change anything you like before you submit it: it's plain text.</p>

  <div class="uc-form" role="group" aria-labelledby="uc-form-t">
    <p class="uc-form-t" id="uc-form-t">Create your activities list</p>
    <div class="uc-field">
      <div class="uc-field-h">
        <span class="uc-label" id="uc-l-title">List Title</span>
        <button type="button" class="uc-copy" data-copy="uc-v-title" aria-describedby="uc-l-title" hidden>Copy</button>
      </div>
      <p class="uc-input" id="uc-v-title" translate="no">{listTitle}</p>
    </div>
    <div class="uc-field">
      <div class="uc-field-h">
        <span class="uc-label" id="uc-l-list">List of activities</span>
        <button type="button" class="uc-copy" data-copy="uc-v-list" aria-describedby="uc-l-list" hidden>Copy</button>
      </div>
      <pre class="uc-input uc-area" id="uc-v-list" translate="no">{list}</pre>
    </div>
    <p class="sr-only" role="status" id="uc-copy-status"></p>
  </div>

  <h3>Create it in your server</h3>
  <ol class="uc-steps">
    <li>In the channel where the list will live, run <code>/create-list</code>.</li>
    <li>Click <strong>Create your list</strong>. If your server has <a href="/docs/configuration/#tips">Tips</a> off, the form opens straight away.</li>
    <li>Paste the title into <strong>List Title</strong> and the list into <strong>List of activities</strong>, then submit.</li>
  </ol>
  <p>
    Or skip the form: download the file and attach it to the <code>file</code> option of <code>/create-list</code>.
    The list appears at once.
  </p>
  <p class="cta-row uc-file">
    <a class="btn-ghost" href={`/use-cases/${slug}.txt`} download={nomeFile(listTitle)}>Download the file</a>
  </p>
  <p>
    In the <a href="/docs/activity/#the-home-of-the-channel">Activity</a>, press <strong>New list</strong> on the
    home of the channel and paste the same title and tasks.
  </p>
</section>

<script>
  // Copy: scrive negli appunti il testo del campo, e lo dice anche a chi usa uno screen reader. Il testo di un
  // <pre> arriva com'è, a capo e rientri compresi: sono la struttura della lista.
  const stato = document.getElementById('uc-copy-status');
  if (navigator.clipboard) {
    document.querySelectorAll<HTMLButtonElement>('.uc-copy').forEach((b) => {
      b.hidden = false;
      let timer: number | undefined;
      b.addEventListener('click', async () => {
        const testo = document.getElementById(b.dataset.copy ?? '')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(testo);
          b.textContent = 'Copied';
          if (stato) stato.textContent = 'Copied to the clipboard.';
        } catch {
          b.textContent = 'Select it by hand';
          if (stato) stato.textContent = 'The browser blocked the clipboard: select the text and copy it.';
        }
        clearTimeout(timer);
        timer = window.setTimeout(() => { b.textContent = 'Copy'; }, 2500);
      });
    });
  }
</script>
