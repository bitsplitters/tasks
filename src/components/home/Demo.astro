---
/*
 * Le due modalità, da provare (spec 2026-11-15-home-video-e-demo-design.md, §5 e §8.6): le scene dei video, mosse da
 * chi guarda, in due tab. Nasce sul canale, nello stato di partenza: il task 3 con l'owner e il promemoria, come alla
 * fine dei video, i task 2 e 2.1 da fare. demo.ts aggiunge gli eventi e tooltip.ts i tooltip; senza JavaScript resta
 * il canale fermo.
 *
 * La frase sotto il titolo cambia coi telefoni, dove il passaggio del mouse non c'è: (hover: none) in home.css.
 */
import './scene.css';
import ChannelScene from './ChannelScene.astro';
import ActivityScene from './ActivityScene.astro';
---
<section class="h-sec wrap" id="two-ways" aria-labelledby="h-demo-title">
  <h2 id="h-demo-title">Two ways to work. Try them both.</h2>
  <p class="h-intro">The real interface, right here. <span class="h-hover">Hover any button to see what it does.</span><span class="h-touch">Press and hold any button to see what it does.</span></p>
  <div class="dm" data-demo>
    <div class="dm-tabs" role="tablist" aria-label="Two ways to work">
      <button
        type="button" role="tab" class="dm-tab" id="dm-t-channel" data-tab="channel" aria-controls="dm-p-channel"
        aria-selected="true" tabindex="0"
      >In the channel</button>
      <button
        type="button" role="tab" class="dm-tab" id="dm-t-activity" data-tab="activity" aria-controls="dm-p-activity"
        aria-selected="false" tabindex="-1"
      >In the Activity <span class="h-new">New in 2.0</span></button>
    </div>
    <div class="dm-panel" role="tabpanel" id="dm-p-channel" data-panel="channel" aria-labelledby="dm-t-channel">
      <p class="dm-say"><strong>On the fly.</strong> The list lives in the conversation: everyone sees it, and a tick takes two clicks.</p>
      <div class="sc-box dm-box">
        <div class="scene sc-live" data-scene="channel">
          <ChannelScene owner promemoria />
          {/* Il fumetto: cosa farebbe Discord col pulsante acceso. Sempre nel DOM, vuoto quando non serve, perché
              gli screen reader annunciano il testo che arriva in una regione role="status" già presente. */}
          <p class="dm-bubble" data-k="bubble" role="status"></p>
        </div>
      </div>
    </div>
    <div class="dm-panel" role="tabpanel" id="dm-p-activity" data-panel="activity" aria-labelledby="dm-t-activity" hidden>
      <p class="dm-say"><strong>Together, with room to work.</strong> A full window inside Discord, on desktop and mobile, where the team shapes the list live, for as long as the session lasts.</p>
      <div class="sc-box dm-box">
        <div class="scene sc-live" data-scene="activity">
          <ActivityScene owner promemoria />
        </div>
      </div>
    </div>
    <button type="button" class="btn-ghost dm-reset" data-k="reset" hidden>Start over</button>
  </div>
</section>
