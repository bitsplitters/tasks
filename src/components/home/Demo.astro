---
/*
 * Le due modalità, da provare (spec 2026-11-15-home-video-e-demo-design.md, §5 e §8.6): le scene dei video, mosse da
 * chi guarda, in due tab. Nasce sul canale, con la lista della demo (demo/modello.ts): il task 3 con l'owner e il
 * promemoria, come alla fine dei video, i task 2 e 2.1 da fare. demo.ts aggiunge gli eventi e tooltip.ts i tooltip;
 * senza JavaScript resta il canale fermo.
 *
 * La frase sotto il titolo cambia coi telefoni, dove il passaggio del mouse non c'è: (hover: none) in home.css.
 */
import './scene.css';
import ChannelScene from './ChannelScene.astro';
import ActivityScene from './ActivityScene.astro';
import { usaLingua } from './demo/lingua.ts';
import { listaDellaDemo } from './demo/modello.ts';
import type { Lingua } from '../../i18n/lingue.ts';
import { traduttore } from '../../i18n/t.ts';

interface Props { lingua: Lingua; }
const { lingua } = Astro.props;
const tt = traduttore(lingua, 'home');
// La lista della demo nasce qui, prima delle scene: già nella lingua della pagina (demo/lingua.ts).
usaLingua(lingua);
---
<section class="h-sec wrap" id="two-ways" aria-labelledby="h-demo-title">
  <h2 id="h-demo-title">{tt('demo.titolo')}</h2>
  <p class="h-intro">{tt('demo.intro')} <span class="h-hover">{tt('demo.hover')}</span><span class="h-touch">{tt('demo.touch')}</span></p>
  <div class="dm" data-demo>
    <div class="dm-tabs" role="tablist" aria-label={tt('modi.label')}>
      <button
        type="button" role="tab" class="dm-tab" id="dm-t-channel" data-tab="channel" aria-controls="dm-p-channel"
        aria-selected="true" tabindex="0"
      >{tt('modi.canale')}</button>
      <button
        type="button" role="tab" class="dm-tab" id="dm-t-activity" data-tab="activity" aria-controls="dm-p-activity"
        aria-selected="false" tabindex="-1"
      >{tt('modi.activity')}</button>
    </div>
    <div class="dm-panel" role="tabpanel" id="dm-p-channel" data-panel="channel" aria-labelledby="dm-t-channel">
      <p class="dm-say" set:html={tt('demo.canale.frase')} />
      <div class="sc-box dm-box">
        <div class="scene sc-live sc-auto" data-scene="channel">
          <ChannelScene lista={listaDellaDemo()} lingua={lingua} />
          {/* Il fumetto: i rifiuti e gli esiti brevi del bot. Sempre nel DOM, vuoto quando non serve, perché gli
              screen reader annunciano il testo che arriva in una regione role="status" già presente. */}
          <p class="dm-bubble" data-k="bubble" role="status"></p>
        </div>
      </div>
    </div>
    <div class="dm-panel" role="tabpanel" id="dm-p-activity" data-panel="activity" aria-labelledby="dm-t-activity" hidden>
      <p class="dm-say" set:html={tt('demo.activity.frase')} />
      <div class="sc-box dm-box">
        <div class="scene sc-live" data-scene="activity">
          <ActivityScene lista={listaDellaDemo()} lingua={lingua} />
          <p class="dm-bubble" data-k="bubble" role="status"></p>
        </div>
      </div>
    </div>
    <button type="button" class="btn-ghost dm-reset" data-k="reset" hidden>{tt('demo.reset')}</button>
  </div>
</section>
<script>
  import { avviaDemo } from './demo';
  avviaDemo();
</script>
