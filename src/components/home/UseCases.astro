---
/*
 * I casi d'uso nella home (spec 2026-11-20-casi-d-uso-sito-design.md, §11.3, e 2026-11-20-casi-d-uso-esempi-completi-
 * design.md, §7, nel repo team-tasks-manager): fra il perché (Pillars) e le funzionalità (Features), dove chi legge si
 * chiede se TTM fa per lui. Ogni scheda porta alla sua pagina, la storia di un team per una settimana, e mostra il
 * nome del caso e cosa usa (`highlights`). Sul telefono resta una riga col nome. I casi vengono dalla collezione
 * `useCases`, o dalla loro traduzione (lib/casi-lingua.ts): una pagina nuova compare qui da sola.
 */
import type { Lingua } from '../../i18n/lingue.ts';
import { percorso } from '../../i18n/percorsi.ts';
import { traduttore } from '../../i18n/t.ts';
import { casiDellaLingua } from '../../lib/casi-lingua.ts';

interface Props { lingua: Lingua; }
const { lingua } = Astro.props;
const tt = traduttore(lingua, 'home');
const casi = await casiDellaLingua(lingua);
---
<section class="h-sec wrap" id="use-cases" aria-labelledby="h-uc-title">
  <h2 id="h-uc-title">{tt('casi.titolo')}</h2>
  <p class="h-intro">{tt('casi.intro')}</p>
  <ul class="h-ucs" role="list">
    {casi.map((c) => (
      <li>
        <a class="h-uc" href={percorso(lingua, `/use-cases/${c.id}/`)}>
          <h3>{c.data.name}</h3>
          <span class="h-uc-d">{c.data.highlights}</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="h-ucs-more"><a class="h-link" href={percorso(lingua, '/use-cases/')}>{tt('casi.tutti')}</a></p>
</section>
