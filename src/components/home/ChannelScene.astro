---
/*
 * Il canale della home (spec 2026-11-15-home-video-e-demo-design.md, §4.2, §5.2 e §5.6; spec
 * 2026-11-15-demo-fedele-design.md): il messaggio della lista com'è nel bot (EmbedDellaLista), col selettore, la prima
 * riga con l'Activity per prima, la seconda coi pulsanti del task. Lo usano la demo e la pagina della registrazione,
 * anche dentro ActivityScene, sotto la finestra.
 *
 * Nasce dalla lista che riceve: le righe e le opzioni del selettore vengono da demo/righe.ts, come quelle che
 * disegnaLista (scene-dom.ts) riscrive nella pagina; gli altri stati li cambiano le funzioni di scene-dom.ts con gli
 * attributi data-*. Gli elementi che si cercano hanno data-k. Il posto del messaggio effimero (eph) e quelli dei menu
 * sotto i pulsanti (sub, wb) nascono vuoti: li riempiono i pezzi della demo (demo/ui), come la modale, che si apre in
 * un velo suo. I testi sono quelli del bot, con la chiave del bundle accanto.
 */
import { CHEV, FRASE_SPUNTA, PRIMA_RIGA, TASTI } from './scene-data';
import { ADESSO, NOME_DEL_CANALE, dataDelCanale, statoIniziale } from './demo/modello.ts';
import type { Lista } from './demo/modello.ts';
import { avanzamento, pulsantiAccesi } from './demo/regole.ts';
import { nomiDi, opzioniDelSelettore, righeDelCanale } from './demo/righe.ts';

interface Props {
  /** La lista da disegnare: quella della demo o quella dei video (demo/modello.ts). */
  lista: Lista;
  /** La lista è nell'Activity: al posto dei pulsanti, «Join the Activity». */
  inActivity?: boolean;
}
const { lista, inActivity = false } = Astro.props;
const stato = { ...statoIniziale(lista), inActivity };
const accesi = pulsantiAccesi(stato);
const spento = (nome: string) => String(!accesi.has(nome));
const pct = avanzamento(lista);
const icona = (n: string) => `/icons/${n}.png`;
const si = (v: boolean) => (v ? '' : undefined);
---
<div class="sc-chan" data-k="chan" data-inact={si(inActivity)}>
  <div class="sc-chhead" aria-hidden="true"><span class="sc-hash">#</span>{NOME_DEL_CANALE}</div>
  <div class="sc-feed" data-k="feed">
    <div class="sc-msg">
      <img class="sc-avatar" src="/icons/ttm-avatar.png" alt="" />
      <p class="sc-mhead" data-k="msghead">
        <span class="sc-name">Team Tasks Manager</span><span class="sc-app">APP</span>
        <span class="sc-time">{dataDelCanale(ADESSO, 't')}</span>
      </p>
      <div class="sc-embed">
        <p class="sc-title">{lista.titolo}</p>
        <div class="sc-rows" set:html={righeDelCanale(lista, nomiDi(stato))}></div>
        {/* tasklist.activity.line, al posto della riga dei consigli */}
        <p class="sc-actline"><img src={icona('activity_blue')} alt="" /> This list is being worked on in the Activity.</p>
        <div class="sc-bar" data-bar data-empty={si(pct === 0)} style={`--pct: ${pct}%`}>
          <div class="sc-bar-fill"></div>
        </div>
      </div>
      <div class="sc-comps">
        <div class="sc-selwrap">
          <button
            type="button" class="sc-sel" data-k="sel" aria-haspopup="listbox" aria-expanded="false"
            aria-disabled={spento('sel')}
          >
            <span data-k="sel-text">{FRASE_SPUNTA}</span>
            <svg class="sc-chev" viewBox="0 0 24 24" aria-hidden="true"><path d={CHEV} fill="currentColor" /></svg>
          </button>
          {/* Le opzioni: l'emoji della casella e «<posizione> <testo>», senza descrizione (TaskActivityConverter). */}
          <div class="sc-menu" data-k="menu" role="listbox" set:html={opzioniDelSelettore(lista)}></div>
        </div>
        <div class="sc-btns">
          {PRIMA_RIGA.map((p) => (
            <button
              type="button" class="sc-btn sc-blue" data-k={`b-${p.k}`} data-tt={`ch-${p.k}`} aria-label={p.nome}
              aria-disabled={spento(p.k)}
            ><img src={icona(p.icona)} alt="" /></button>
          ))}
        </div>
        <div class="sc-btns">
          {TASTI.map((t) => (
            <button
              type="button" class="sc-btn" data-k={`b-${t.k}`} data-tasto={t.k} data-tt={`ch-${t.k}`}
              aria-label={t.nome} aria-pressed="false" aria-disabled={spento(t.k)}
            ><img src={icona(t.icona)} alt="" /></button>
          ))}
        </div>
        {/* Il menu di menzioni di Owner e Tag (tasklist.slct.owner, .tag, ui/menzioni.ts) e quello dei webhook già
            creati (tasklist.slct.webhook, ui/scelta.ts), quando il loro pulsante è blu. */}
        <div class="sc-submenu" data-k="sub" hidden></div>
        <div class="sc-wm" data-k="wb" hidden></div>
      </div>
      <div class="sc-join">
        <button type="button" class="sc-btn sc-blue sc-joinbtn" data-k="b-join" aria-disabled={spento('join')}>
          <img src={icona('activity')} alt="" />Join the Activity
        </button>
      </div>
    </div>
    {/* Il messaggio effimero sotto la lista, che vede solo chi agisce: lo scrive la demo. */}
    <div class="sc-eph" data-k="eph" hidden></div>
  </div>
  <div class="sc-input" aria-hidden="true">Message #{NOME_DEL_CANALE}</div>
</div>
