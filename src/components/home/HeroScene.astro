---
/*
 * La scena dell'apertura (spec della home, §4): la lista nel canale, il pulsante dell'Activity, la finestra, un task
 * spuntato, owner e promemoria su un altro. È un disegno: aria-hidden, e per gli screen reader parla la didascalia.
 *
 * Il markup nasce sull'ultimo fotogramma (classi is-open, is-ticked, has-owner, has-reminder), quello che vede chi non
 * ha JavaScript e chi chiede meno animazioni. Lo script inline in fondo la riporta al primo fotogramma prima che si
 * veda; scene.ts la fa avanzare. La lista è quella di «Try it», ridotta a quattro task, per continuità.
 */
const TITOLO = 'Roster & scrims — week 12';
const TASK = [
  { n: '1', testo: "Confirm the five-man roster for Saturday's scrim block", fatto: true },
  { n: '2', testo: 'Lock the scrim block vs. Nova Collective', fatto: false },
  { n: '3', testo: 'VOD review: mid rotations, game 3', fatto: false },
  { n: '4', testo: 'Publish the match-day graphic', fatto: false },
];
const VUOTA = '/icons/checkbox_empty.png';
const PIENA = '/icons/checkbox_marked.png';
---
<figure class="sc-fig">
  <div class="scene is-open is-ticked has-owner has-reminder" data-scene aria-hidden="true">
    <div class="sc-channel">
      <div class="sc-chhead"><span class="sc-hash">#</span>scrims</div>
      <div class="sc-msg">
        <img class="sc-avatar" src="/icons/ttm-avatar.png" alt="" />
        <div class="sc-msgbody">
          <div class="sc-head">
            <span class="sc-name">Team Tasks Manager</span><span class="sc-app">APP</span><span class="sc-time">Today at 18:04</span>
          </div>
          <div class="sc-embed">
            <p class="sc-title">{TITOLO}</p>
            <ul class="sc-tasks">
              {TASK.map((t) => (
                <li class:list={['sc-task', { 'is-done': t.fatto }]}>
                  <div class="sc-line">
                    <span class="sc-n">{t.n}</span>
                    <span class="sc-cb"><img class="sc-off" src={VUOTA} alt="" /><img class="sc-on" src={PIENA} alt="" /></span>
                    <span class="sc-txt">{t.testo}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
          {/* Sotto la lista, come nel canale dalla 2.0.0: il selettore, la prima riga con l'Activity per prima, la
              seconda coi pulsanti del task. Mentre la lista è nell'Activity resta un solo pulsante (sc-join-wrap). */}
          <div class="sc-ctrls">
            <div class="sc-sel"><span>{TITOLO}</span><span>&#9662;</span></div>
            <div class="sc-row">
              <span class="sc-b sc-b-act" data-k="act"><img src="/icons/activity.png" alt="" /></span>
              <span class="sc-b"><img src="/icons/edit.png" alt="" /></span>
              <span class="sc-b"><img src="/icons/clean.png" alt="" /></span>
              <span class="sc-b"><img src="/icons/reopen.png" alt="" /></span>
              <span class="sc-b"><img src="/icons/other.png" alt="" /></span>
            </div>
            <div class="sc-row">
              <span class="sc-b sc-b-grey"><img src="/icons/task.png" alt="" /></span>
              <span class="sc-b sc-b-grey"><img src="/icons/owner.png" alt="" /></span>
              <span class="sc-b sc-b-grey"><img src="/icons/tag.png" alt="" /></span>
              <span class="sc-b sc-b-grey"><img src="/icons/alertW.png" alt="" /></span>
              <span class="sc-b sc-b-grey"><img src="/icons/api.png" alt="" /></span>
            </div>
          </div>
          <div class="sc-join-wrap">
            <span class="sc-b"><img src="/icons/activity.png" alt="" /></span>
            <p class="sc-joinnote"><img src="/icons/activity_blue.png" alt="" />This list is being worked on in the Activity</p>
          </div>
        </div>
      </div>
      <div class="sc-input">Message #scrims</div>
    </div>

    <div class="sc-shade"></div>

    <div class="sc-window">
      <div class="sc-winbar"><img src="/icons/ttm-avatar.png" alt="" />Team Tasks Manager<span class="sc-winx">&times;</span></div>
      <div class="sc-winbody">
        <div class="sc-firstrow">
          <span class="sc-b"><img src="/icons/doc.png" alt="" /></span>
          <span class="sc-b"><img src="/icons/edit.png" alt="" /></span>
          <span class="sc-b"><img src="/icons/clean.png" alt="" /></span>
          <span class="sc-b"><img src="/icons/reopen.png" alt="" /></span>
          <span class="sc-b sc-b-raised"><img src="/icons/back.png" alt="" /></span>
        </div>
        <div class="sc-embed">
          <p class="sc-title">{TITOLO}</p>
          <ul class="sc-tasks">
            <li class="sc-task is-done">
              <div class="sc-line">
                <span class="sc-n">1</span>
                <span class="sc-cb"><img class="sc-off" src={VUOTA} alt="" /><img class="sc-on" src={PIENA} alt="" /></span>
                <span class="sc-txt">{TASK[0].testo}</span>
              </div>
            </li>
            <li class="sc-task sc-t2">
              <div class="sc-line">
                <span class="sc-n">2</span>
                <span class="sc-cb" data-k="cb2"><img class="sc-off" src={VUOTA} alt="" /><img class="sc-on" src={PIENA} alt="" /></span>
                <span class="sc-txt">{TASK[1].testo}</span>
              </div>
            </li>
            {/* Il task 3 com'è nel canale (RigheDellaLista): la riga del promemoria sopra, col numero; la casella sotto,
                con l'owner davanti al testo. */}
            <li class="sc-task" data-k="task3">
              <div class="sc-reveal sc-reveal-rem"><div>
                <div class="sc-line">
                  <span class="sc-n">3</span>
                  <img class="sc-bell" src="/icons/alert.png" alt="" />
                  <span class="sc-meta">in 2 days at 20:30</span>
                </div>
              </div></div>
              <div class="sc-line">
                <span class="sc-n sc-n3">3</span>
                <span class="sc-cb"><img class="sc-off" src={VUOTA} alt="" /><img class="sc-on" src={PIENA} alt="" /></span>
                <span class="sc-txt" data-k="t3"><span class="sc-owner">@Mia</span><span class="sc-colon">: </span>{TASK[2].testo}</span>
              </div>
            </li>
            {/* Il pannello del task, agganciato sotto le sue righe (pagina dell'Activity, TaskPanel): la frase con la X,
                i cinque pulsanti della seconda riga, l'area di misura fissa, Close a sinistra e Save a destra. */}
            <li class="sc-reveal sc-reveal-panel"><div>
              <div class="sc-panel">
                <div class="sc-phrase"><span>Choose what to change in task 3</span><span>&times;</span></div>
                <div class="sc-prow">
                  <span class="sc-pb"><img src="/icons/task.png" alt="" /></span>
                  <span class="sc-pb" data-k="p-owner"><img src="/icons/owner.png" alt="" /></span>
                  <span class="sc-pb"><img src="/icons/tag.png" alt="" /></span>
                  <span class="sc-pb" data-k="p-rem"><img src="/icons/alertW.png" alt="" /></span>
                  <span class="sc-pb"><img src="/icons/api.png" alt="" /></span>
                </div>
                <div class="sc-area">
                  <div class="sc-view sc-view-owner">
                    <div class="sc-field sc-search">
                      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                    </div>
                    <div class="sc-person" data-k="mia"><span class="sc-av" style="--av:#eb459e">M</span>Mia<span class="sc-tick">&#10003;</span></div>
                    <div class="sc-person"><span class="sc-av" style="--av:#23a55a">L</span>Leo</div>
                  </div>
                  <div class="sc-view sc-view-rem">
                    <div class="sc-fields">
                      <div class="sc-field"><span class="sc-lab">Date</span><span class="sc-val" data-v="date">in 2 days</span></div>
                      <div class="sc-field"><span class="sc-lab">Time</span><span class="sc-val sc-val-time">20:30</span></div>
                    </div>
                    <div class="sc-field"><span class="sc-lab">Time zone</span><span class="sc-zone" data-v="zone">UTC</span></div>
                    <p class="sc-device">On this device: <span data-v="zone">UTC</span></p>
                  </div>
                </div>
                <div class="sc-pfoot">
                  <span class="sc-btn" data-k="close">Close</span>
                  <span class="sc-btn sc-btn-blue sc-save" data-k="save">Save</span>
                </div>
              </div>
            </div></li>
            <li class="sc-task">
              <div class="sc-line">
                <span class="sc-n">4</span>
                <span class="sc-cb"><img class="sc-off" src={VUOTA} alt="" /><img class="sc-on" src={PIENA} alt="" /></span>
                <span class="sc-txt">{TASK[3].testo}</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <svg class="sc-cursor" viewBox="0 0 24 24"><path d="M5 2.5v17l4.3-4.1 2.9 6.4 3-1.4-2.9-6.3h6.1z" fill="#fff" stroke="#111" stroke-width="1.3" stroke-linejoin="round" /></svg>
    <span class="sc-tap"></span>
  </div>

  <figcaption class="sc-cap">
    <span class="sr-only">Animation: a Team Tasks Manager list in a Discord channel. The Activity button opens it in a window, where one task is ticked and another gets an owner and a reminder.</span>
    {/* role="list": con list-style none Safari toglie all'elenco il suo ruolo. */}
    <ol class="sc-steps" role="list">
      <li class="is-lit">Open the list in the Activity</li>
      <li class="is-lit">Tick a task</li>
      <li class="is-lit">Set an owner and a reminder</li>
    </ol>
    <button type="button" class="sc-ctl" data-mode="static" hidden>
      <svg class="sc-i sc-i-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="2.5" width="3" height="11" rx="1" fill="currentColor" /><rect x="9.5" y="2.5" width="3" height="11" rx="1" fill="currentColor" /></svg>
      <svg class="sc-i sc-i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.8v10.4a.6.6 0 0 0 .9.5l8.2-5.2a.6.6 0 0 0 0-1L5.4 2.3a.6.6 0 0 0-.9.5z" fill="currentColor" /></svg>
      <svg class="sc-i sc-i-replay" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5a5.5 5.5 0 1 1-5.2 3.7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><path d="M2 2.2v4.3h4.3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span class="sr-only" data-label>Play the animation</span>
    </button>
  </figcaption>
</figure>

<script is:inline>
  // Prima del primo disegno (spec della home, §4.3): chi accetta il movimento vede la scena dall'inizio. Gli altri, e
  // chi non ha JavaScript, restano sull'ultimo fotogramma con cui nasce il markup. Uno script a modulo arriverebbe
  // dopo il primo disegno: si vedrebbe prima la fine, poi l'inizio.
  (function () {
    var scena = document.querySelector('[data-scene]');
    if (!scena || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    scena.classList.add('sc-noanim');
    scena.classList.remove('is-open', 'is-ticked', 'has-owner', 'has-reminder');
    scena.setAttribute('data-start', '');
    var tappe = scena.parentNode.querySelectorAll('.sc-steps li');
    for (var i = 0; i < tappe.length; i++) tappe[i].classList.remove('is-lit');
  })();
</script>

<script>
  import { avviaScena } from './scene';
  avviaScena();
</script>
