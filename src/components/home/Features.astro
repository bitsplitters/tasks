---
/*
 * Le funzionalità principali (spec 2026-11-15-home-video-e-demo-design.md, §6.2 e §8.4): sei voci con l'emoji del bot,
 * tre colonne sul computer, due sul tablet, una sul telefono. Webhooks porta l'etichetta «Premium», un link ai piani:
 * col piano Free non se ne creano di nuovi (premium.md). Nessun prezzo.
 */
import type { Lingua } from '../../i18n/lingue.ts';
import { percorso } from '../../i18n/percorsi.ts';
import { t, traduttore } from '../../i18n/t.ts';

interface Props { lingua: Lingua; }
const { lingua } = Astro.props;
const tt = traduttore(lingua, 'home');

interface Voce {
  icona: string;
  chiave: string;
  premium?: boolean;
}
const VOCI: Voce[] = [
  { icona: 'task_list', chiave: 'liste' },
  { icona: 'owner', chiave: 'owner' },
  { icona: 'alertW', chiave: 'promemoria' },
  { icona: 'single_task', chiave: 'gruppi' },
  { icona: 'doc', chiave: 'cronologia' },
  { icona: 'api', chiave: 'webhook', premium: true },
];
---
<section class="h-sec wrap" aria-labelledby="h-features-title">
  <h2 id="h-features-title">{tt('funzioni.titolo')}</h2>
  <ul class="h-feats" role="list">
    {VOCI.map((v) => (
      <li>
        <img src={`/icons/${v.icona}.png`} alt="" width="32" height="32" />
        <div>
          <h3>
            {tt(`funzioni.${v.chiave}.t`)}
            {v.premium && (
              <a class="h-new h-premium" href={percorso(lingua, '/premium/')} aria-label={t(lingua, 'comune.premium.funzione')}>Premium</a>
            )}
          </h3>
          <p>{tt(`funzioni.${v.chiave}.d`)}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
