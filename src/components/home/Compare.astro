---
/*
 * Il confronto (spec della home, §3.4 e §6): una tabella, la colonna di TTM accesa in ambra e quella dell'altra app
 * spenta. Gli otto punti di oggi («Without TTM» / «With TTM») sono diventati queste righe; «Getting started» è nuova,
 * ed è vera: per TTM basta l'account Discord.
 *
 * Sotto i 720 px ogni riga diventa un blocco. I role restano sulla tabella perché, cambiando display, alcuni browser
 * ne perdono la semantica; il nome della colonna ripetuto in ogni cella è solo per gli occhi (aria-hidden), perché gli
 * screen reader lo hanno già dall'intestazione.
 *
 * Il segno (✓, –) sta fuori dal testo, così le righe che vanno a capo si allineano al testo e non al segno; le parole
 * col trattino («re-explaining») non si spezzano. Un testo in più frasi (un array) va a capo dopo ognuna: la seconda,
 * corta, resta intera su una riga sua (richiesta dell'utente del 15/11).
 */
type Testo = string | readonly string[];
const COLONNE = { ttm: 'Team Tasks Manager', altra: 'A separate task app' };
const RIGHE: { voce: string; ttm: Testo; altra: Testo }[] = [
  {
    voce: 'Where the tasks are',
    ttm: 'In the channel where the work is discussed.',
    altra: 'In another tool, while the team talks on Discord.',
  },
  {
    voce: 'Keeping up to date',
    ttm: ['The whole team sees the same list.', 'All in real time.'],
    altra: 'Every update means switching windows, copying links, re-explaining status.',
  },
  {
    voce: 'The full picture',
    ttm: 'One list, in the place everyone already looks.',
    altra: 'Scattered across windows: no one has the full picture.',
  },
  {
    voce: 'Deadlines',
    ttm: 'The owner gets the reminder on Discord.',
    altra: 'Nobody owns the reminder, so deadlines slip.',
  },
  {
    voce: 'Getting started',
    ttm: ['Add the bot and type one command.', 'No new accounts.'],
    altra: 'Sign-ups for everyone, and a new tool to learn.',
  },
];
const frasi = (t: Testo) => (typeof t === 'string' ? [t] : t);
const parti = (testo: string) => testo.split(/(\S+-\S+)/);
---
<section class="h-sec wrap h-compare" aria-labelledby="h-compare-title">
  <h2 id="h-compare-title">Coordination shouldn't cost you your focus.</h2>
  <table class="h-table" role="table">
    <caption class="sr-only">Team Tasks Manager compared with a separate task app</caption>
    <thead role="rowgroup">
      <tr role="row">
        <td role="cell"></td>
        <th scope="col" role="columnheader" class="h-col-acc">{COLONNE.ttm}</th>
        <th scope="col" role="columnheader" class="h-col-dim">{COLONNE.altra}</th>
      </tr>
    </thead>
    <tbody role="rowgroup">
      {RIGHE.map((r) => (
        <tr role="row">
          <th scope="row" role="rowheader">{r.voce}</th>
          <td role="cell" class="h-acc">
            <span class="h-cell-col" aria-hidden="true">{COLONNE.ttm}</span>
            <span class="h-line">
              <span class="h-mark" aria-hidden="true">&#10003;</span>
              <span>{frasi(r.ttm).map((f) => (
                <span class="h-frase">{parti(f).map((p, i) => (i % 2 ? <span class="h-nobr">{p}</span> : p))}</span>
              ))}</span>
            </span>
          </td>
          <td role="cell" class="h-dim">
            <span class="h-cell-col" aria-hidden="true">{COLONNE.altra}</span>
            <span class="h-line">
              <span class="h-mark" aria-hidden="true">&ndash;</span>
              <span>{frasi(r.altra).map((f) => (
                <span class="h-frase">{parti(f).map((p, i) => (i % 2 ? <span class="h-nobr">{p}</span> : p))}</span>
              ))}</span>
            </span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</section>
