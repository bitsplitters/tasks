---
/*
 * Il confronto (spec della home, §3.4 e §6): una tabella, la colonna di TTM accesa in ambra e quella dell'altra app
 * spenta. Gli otto punti di oggi («Without TTM» / «With TTM») sono diventati queste righe; «Getting started» è nuova,
 * ed è vera: per TTM basta l'account Discord.
 *
 * Sotto i 720 px si vede una colonna alla volta (home.css): sopra la tabella un interruttore a pillola, acceso su TTM,
 * mostra l'altra app quando si tocca la sua metà. È la variante «C», scelta dall'utente il 16/11 fra le tre del
 * confronto sul telefono. Prima ogni cella era un blocco col nome della colonna ripetuto: un muro alto il doppio
 * (segnalazione dell'utente del 15/11). L'interruttore è un gruppo radio senza JavaScript, come lo switch della pagina
 * dei piani; il suo nome è la didascalia della tabella. I role restano sulla tabella perché, cambiando display, alcuni
 * browser ne perdono la semantica; aria-colindex dice agli screen reader quale colonna resta quando l'altra è nascosta.
 *
 * Il segno (✓, –) sta fuori dal testo, così le righe che vanno a capo si allineano al testo e non al segno; le parole
 * col trattino («re-explaining») non si spezzano. Un testo in più frasi (righe separate da `\n` nei testi) va a capo
 * dopo ognuna: la seconda, corta, resta intera su una riga sua (richiesta dell'utente del 15/11).
 */
import type { Lingua } from '../../i18n/lingue.ts';
import { traduttore } from '../../i18n/t.ts';

interface Props { lingua: Lingua; }
const tt = traduttore(Astro.props.lingua, 'home');

const COLONNE = { ttm: tt('confronto.ttm'), altra: tt('confronto.altra') };
const RIGHE = [1, 2, 3, 4, 5].map((n) => ({
  voce: tt(`confronto.${n}.voce`),
  ttm: tt(`confronto.${n}.ttm`),
  altra: tt(`confronto.${n}.altra`),
}));
const frasi = (testo: string) => testo.split('\n');
const parti = (testo: string) => testo.split(/(\S+-\S+)/);
---
<section class="h-sec wrap h-compare" aria-labelledby="h-compare-title">
  <h2 id="h-compare-title">{tt('confronto.titolo')}</h2>
  <fieldset class="h-switch" aria-labelledby="h-compare-caption">
    <input type="radio" name="h-mostra" id="h-mostra-ttm" value="ttm" checked />
    <label for="h-mostra-ttm">{COLONNE.ttm}</label>
    <input type="radio" name="h-mostra" id="h-mostra-altra" value="altra" />
    <label for="h-mostra-altra">{COLONNE.altra}</label>
  </fieldset>
  <table class="h-table" role="table" aria-colcount="3">
    <caption class="sr-only" id="h-compare-caption">{tt('confronto.didascalia')}</caption>
    <thead role="rowgroup">
      <tr role="row">
        <td role="cell" aria-colindex="1"></td>
        <th scope="col" role="columnheader" aria-colindex="2" class="h-col-acc">{COLONNE.ttm}</th>
        <th scope="col" role="columnheader" aria-colindex="3" class="h-col-dim">{COLONNE.altra}</th>
      </tr>
    </thead>
    <tbody role="rowgroup">
      {RIGHE.map((r) => (
        <tr role="row">
          <th scope="row" role="rowheader" aria-colindex="1">{r.voce}</th>
          <td role="cell" aria-colindex="2" class="h-acc">
            <span class="h-line">
              <span class="h-mark" aria-hidden="true">&#10003;</span>
              <span>{frasi(r.ttm).map((f) => (
                <span class="h-frase">{parti(f).map((p, i) => (i % 2 ? <span class="h-nobr">{p}</span> : p))}</span>
              ))}</span>
            </span>
          </td>
          <td role="cell" aria-colindex="3" class="h-dim">
            <span class="h-line">
              <span class="h-mark" aria-hidden="true">&ndash;</span>
              <span>{frasi(r.altra).map((f) => (
                <span class="h-frase">{parti(f).map((p, i) => (i % 2 ? <span class="h-nobr">{p}</span> : p))}</span>
              ))}</span>
            </span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</section>
