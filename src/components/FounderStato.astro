---
// Lo stato del programma Founder, scritto in due pagine: /premium/ (sezione #founder) e /beta/ (la linea del tempo).
// Quando la finestra si apre, la frase cambia nei testi (`premium.fd.stato`). Solo il contenuto: il paragrafo, il
// pallino e le classi restano a ciascuna pagina (spec docs/superpowers/specs/2026-11-15-pagina-beta-design.md, §4.4,
// nel repo team-tasks-manager).
import type { Lingua } from '../i18n/lingue.ts';
import { percorso } from '../i18n/percorsi.ts';
import { t } from '../i18n/t.ts';

interface Props { lingua: Lingua; }
const { lingua } = Astro.props;
---
<Fragment set:html={t(lingua, 'premium.fd.stato', { community: percorso(lingua, '/docs/community/') })} />
