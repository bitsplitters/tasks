---
import DiscordLimit from './DiscordLimit.astro';
import type { Lingua } from '../../i18n/lingue.ts';
import { percorso } from '../../i18n/percorsi.ts';
import { traduttore } from '../../i18n/t.ts';
/*
 * Il confronto dei limiti (spec della pagina Premium, §3.4 e §6), con la tabella della home (vetrina.css):
 * Premium è la colonna accesa, Free quella spenta. Sotto i 720 px ogni riga diventa un blocco: la voce sopra,
 * Free e Premium affiancati sotto (premium.css). Il nome della colonna ripetuto in ogni cella è solo per gli occhi
 * (aria-hidden): gli screen reader lo hanno già dall'intestazione.
 */
interface Props { lingua: Lingua; }
const { lingua } = Astro.props;
const tt = traduttore(lingua, 'premium');
const COLONNE = { free: tt('free.nome'), premium: tt('premium.nome') };
// Il segno di Discord sulle righe col limite fissato da Discord: task, persone per proprietario, webhook.
const RIGHE = [1, 2, 3, 4, 5, 6].map((n) => ({
  voce: tt(`confronto.${n}.voce`),
  free: tt(`confronto.${n}.free`),
  premium: tt(`confronto.${n}.premium`),
  discord: [2, 5, 6].includes(n),
}));
---
<section class="h-sec wrap p-compare" aria-labelledby="p-compare-title">
  <h2 id="p-compare-title">{tt('confronto.titolo')}</h2>
  <table class="h-table" role="table">
    <caption class="sr-only">{tt('confronto.didascalia')}</caption>
    <thead role="rowgroup">
      <tr role="row">
        <td role="cell"></td>
        <th scope="col" role="columnheader" class="h-col-dim">{COLONNE.free}</th>
        <th scope="col" role="columnheader" class="h-col-acc">{COLONNE.premium}</th>
      </tr>
    </thead>
    <tbody role="rowgroup">
      {RIGHE.map((r) => (
        <tr role="row">
          <th scope="row" role="rowheader">{r.voce}</th>
          <td role="cell" class="h-dim">
            <span class="h-cell-col" aria-hidden="true">{COLONNE.free}</span>{r.free}
          </td>
          <td role="cell" class="h-acc">
            <span class="h-cell-col" aria-hidden="true">{COLONNE.premium}</span>{r.premium}{r.discord && <DiscordLimit lingua={lingua} />}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="p-after" set:html={tt('confronto.dopo', { premium: percorso(lingua, '/docs/premium/') })} />
</section>
