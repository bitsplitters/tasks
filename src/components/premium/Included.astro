---
/*
 * Incluso in entrambi (spec della pagina Premium, §3.5 e §6): sei voci, tre colonne dagli 860 px, due dai 560.
 * La spunta è la stessa per tutte: fra le icone del bot mancano quelle della cronologia e delle lingue, e
 * mescolare icone e glifi farebbe sembrare a metà le voci senza icona. Niente riquadri: la home li usa già.
 */
import type { Lingua } from '../../i18n/lingue.ts';
import { traduttore } from '../../i18n/t.ts';

interface Props { lingua: Lingua; }
const tt = traduttore(Astro.props.lingua, 'premium');
const VOCI = [1, 2, 3, 4, 5, 6].map((n) => ({ titolo: tt(`inclusi.${n}.t`), testo: tt(`inclusi.${n}.d`) }));
---
<section class="h-sec wrap" aria-labelledby="p-included-title">
  <h2 id="p-included-title">{tt('inclusi.titolo')}</h2>
  <p class="h-intro">{tt('inclusi.intro')}</p>
  <ul class="p-grid" role="list">
    {VOCI.map((v) => (
      <li>
        <span class="p-tick" aria-hidden="true">&#10003;</span>
        <h3>{v.titolo}</h3>
        <p>{v.testo}</p>
      </li>
    ))}
  </ul>
  <p class="p-after">{tt('inclusi.dopo')}</p>
</section>
