---
/*
 * Incluso in entrambi (spec della pagina Premium, §3.5 e §6): sei voci, tre colonne dagli 860 px, due dai 560.
 * La spunta è la stessa per tutte: fra le icone del bot mancano quelle della cronologia e delle lingue, e
 * mescolare icone e glifi farebbe sembrare a metà le voci senza icona. Niente riquadri: la home li usa già.
 */
const VOCI = [
  { titolo: 'The Activity', testo: 'Open a list in a window inside Discord and work on it together, live.' },
  { titolo: 'Owners and tags', testo: 'Give each task an owner, and tag the people or roles to notify.' },
  { titolo: 'Reminders', testo: 'A ping when a task is due, in your time zone.' },
  { titolo: 'Groups and subtasks', testo: 'Indent a line and it becomes a subtask. Groups are recognized automatically.' },
  { titolo: 'Activity timeline', testo: 'Every change to a list, with who made it, in a dedicated thread.' },
  { titolo: 'Six languages', testo: 'English, Italian, German, French, Spanish and Portuguese.' },
];
---
<section class="h-sec wrap" aria-labelledby="p-included-title">
  <h2 id="p-included-title">Included in both.</h2>
  <p class="h-intro">Every plan gets the whole bot. The limits are the only difference.</p>
  <ul class="p-grid" role="list">
    {VOCI.map((v) => (
      <li>
        <span class="p-tick" aria-hidden="true">&#10003;</span>
        <h3>{v.titolo}</h3>
        <p>{v.testo}</p>
      </li>
    ))}
  </ul>
  <p class="p-after">Every fix and every update reaches Free too.</p>
</section>
