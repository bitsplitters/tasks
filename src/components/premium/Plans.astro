---
import Sbircia from '../mascotte/Sbircia.astro';
import DiscordLimit from './DiscordLimit.astro';
import type { Lingua } from '../../i18n/lingue.ts';
import { percorso } from '../../i18n/percorsi.ts';
import { t, traduttore } from '../../i18n/t.ts';
/*
 * Lo switch fra annuale e mensile e le due card (spec della pagina Premium, §3.3, §4 e §6). Lo switch è un
 * gruppo radio senza JavaScript: premium.css mostra il prezzo scelto con :has(), dalla sezione .p-plans che
 * contiene sia i radio sia le card. Dove :has() manca si vedono tutti e due i prezzi, uno sotto l'altro.
 *
 * I nomi delle card sono h2: la sezione non ha un titolo visibile, e un h3 subito dopo l'h1 salterebbe un livello.
 * La card Free elenca solo quello che il piano dà: senza webhook, la voce non c'è (il dettaglio nella pagina docs
 * Premium). La fascia della beta sta in testa alla card Premium, prima del prezzo: chi legge il prezzo sa già che
 * durante la beta Premium è attivo per tutti (richiesta dell'utente del 2026-11-23).
 * Il pulsante porta a /invite/, che esiste solo in inglese: è il passaggio verso Discord.
 */
interface Props { lingua: Lingua; }
const { lingua } = Astro.props;
const tt = traduttore(lingua, 'premium');
const FREE = [1, 2, 3, 4].map((n) => tt(`free.${n}`));
// Il segno di Discord sulle voci col limite fissato da Discord: 50 task, 25 webhook. La voce 5, i task di più
// persone, ha le due stellette: la nota spiega il ruolo creato da TTM (e cita il suo limite di Discord, 25 persone).
const PREMIUM = [1, 2, 3, 4, 5, 6].map((n) => ({ testo: tt(`premium.${n}`), discord: [2, 6].includes(n), ruoli: n === 5 }));
const aggiungi = t(lingua, 'comune.cta.aggiungi');
---
<section class="p-plans wrap">
  <fieldset class="p-switch">
    <legend class="sr-only">{tt('piani.periodo')}</legend>
    <input type="radio" name="periodo" id="p-mensile" value="mensile" />
    <label for="p-mensile">{tt('piani.mensile')}</label>
    <input type="radio" name="periodo" id="p-annuale" value="annuale" checked />
    <label for="p-annuale">{tt('piani.annuale')} <span class="p-save">{tt('piani.risparmio')}</span></label>
  </fieldset>

  <div class="p-cards">
    <article class="p-card" aria-labelledby="p-free-name">
      <h2 class="p-name" id="p-free-name">{tt('free.nome')}</h2>
      <div class="p-cost">
        <p class="p-price"><span class="p-amount">{tt('free.importo')}</span></p>
        <p class="p-note">{tt('free.nota')}</p>
      </div>
      <ul class="p-list" role="list">
        {FREE.map((v) => <li><span>{v}</span></li>)}
      </ul>
      <a class="btn" href="/invite/">{aggiungi}</a>
    </article>

    <article class="p-card p-card-premium" aria-labelledby="p-premium-name">
      <Sbircia bersaglio=".p-card-premium" class="mx-premium" />
      <h2 class="p-name" id="p-premium-name">{tt('premium.nome')}</h2>
      <p class="p-included">{tt('premium.incluso')}</p>
      <div class="p-cost">
        <div class="p-annuale">
          <p class="p-price"><span class="p-amount">{tt('premium.annuale.importo')}</span> <span class="p-per">{tt('premium.al.mese')} <a class="p-vat" href="#vat">{tt('iva')}</a></span></p>
          <p class="p-note">{tt('premium.annuale.nota')}</p>
        </div>
        <div class="p-mensile">
          <p class="p-price"><span class="p-amount">{tt('premium.mensile.importo')}</span> <span class="p-per">{tt('premium.al.mese')} <a class="p-vat" href="#vat">{tt('iva')}</a></span></p>
          <p class="p-note">{tt('premium.mensile.nota')}</p>
        </div>
      </div>
      <p class="p-tagline">{tt('premium.tagline')}</p>
      <ul class="p-list" role="list">
        {PREMIUM.map((v) => (
          <li><span>{v.testo}{v.discord && <DiscordLimit lingua={lingua} />}{v.ruoli && (
            <><span aria-hidden="true">&nbsp;**</span><span class="sr-only">{tt('ruoli.nota')}</span></>
          )}</span></li>
        ))}
      </ul>
      <a class="btn" href="/invite/">{aggiungi}</a>
    </article>
  </div>

  <div class="p-fine">
    {/* Perché «+ VAT» (spec 2026-11-19-iva-e-note-di-rilascio-design.md, §1-2, nel repo team-tasks-manager): in Discord
        l'IVA del paese di chi compra si aggiunge al pagamento. I «+ VAT» dei prezzi portano qui. */}
    <p id="vat" set:html={tt('fine.iva')} />
    <p>{tt('fine.prezzi')} <a class="h-link" href={percorso(lingua, '/docs/premium/')}>{tt('fine.limiti')}</a></p>
    <p><span aria-hidden="true">*</span> <Fragment set:html={tt('fine.discord', { limiti: percorso(lingua, '/docs/known-limits/') })} /></p>
    <p><span aria-hidden="true">**</span> {tt('fine.ruoli')}</p>
  </div>
</section>
