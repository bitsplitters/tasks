---
// Una pagina della documentazione, in una lingua (spec 2026-11-19-sito-multilingua-design.md, §4.1 e §4.2, nel repo
// team-tasks-manager): la route inglese è src/pages/docs/[...slug].astro, quelle delle altre lingue
// src/pages/[lingua]/docs/[...slug].astro. `id` è il nome della pagina inglese.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import VetrinaFont from '../components/VetrinaFont.astro';
import DocsSearch from '../components/DocsSearch.astro';
import AperturaNoteDiRilascio from '../components/AperturaNoteDiRilascio.astro';
import { docsCard } from '../lib/preview-card';
import { paginaPiani } from '../lib/pagina-piani';
import { GRUPPI_DOCS, POSTI } from '../lib/gruppi-docs';
import { docsDellaLingua } from '../lib/docs-lingua';
import type { Lingua } from '../i18n/lingue.ts';
import { percorso } from '../i18n/percorsi.ts';
import { t, traduttore } from '../i18n/t.ts';
// docs.css dopo Base, che importa global.css: le regole della documentazione vengono dopo quelle comuni.
import '../styles/docs.css';

interface Props {
  lingua: Lingua;
  id: string;
}
const { lingua, id } = Astro.props;
const testo = traduttore(lingua, 'docs');
const PAGINA_PIANI = paginaPiani(lingua);

const all = await docsDellaLingua(lingua);
const pagina = all.find((p) => p.id === id)!;
const { Content, headings } = await render(pagina.entry);

// Le ancore sono quelle dell'inglese in ogni lingua (spec, §8): le dà src/lib/rehype-ancore-inglesi.mjs. Qui si
// confrontano gli id finali della traduzione con quelli della pagina inglese, resa da Astro: se il plugin li
// calcolasse in un altro modo, o se un titolo prendesse un id altrove, la build si ferma invece di pubblicare un link
// rotto.
if (lingua !== 'en' && !pagina.riserva) {
  const inglese = (await docsDellaLingua('en')).find((p) => p.id === id)!;
  const ancore = (h: { slug: string }[]) => h.map((x) => x.slug).join(' ');
  const attese = ancore((await render(inglese.entry)).headings);
  if (ancore(headings) !== attese) {
    throw new Error(`ancore: /${lingua}/docs/${id}/ ha [${ancore(headings)}], l'inglese [${attese}]`);
  }
}

const grouped = GRUPPI_DOCS
  .map((g) => ({ ...g, items: all.filter((d) => d.data.group === g.name) }))
  .filter((g) => g.items.length);
const current = id;
const data = pagina.data;
const posto = data.place ?? null;
---
<Base title={testo('pagina.suffisso', { titolo: data.title })} previewTitle={data.title} description={data.description} embed={docsCard(lingua, data.title, data.description, Astro.url.pathname)}>
  <VetrinaFont slot="head" />
  {/* Il <main> dà a chi usa uno screen reader un punto di arrivo per il contenuto, come nelle pagine della vetrina.
      Porta il carattere: il menu in alto e il piè di pagina restano in mono. */}
  <main class="docs-main">
    <button
      class="docs-menu-toggle" id="docs-menu-toggle" aria-label={testo('menu.apri')}
      aria-expanded="false" aria-controls="docs-side"
    >&#9776; {testo('menu.pulsante')}</button>
    <div class="docs-shell">
      <aside class="docs-side" id="docs-side">
        {/* La prima riga del pannello del telefono: la croce, a destra. Lo switch del tema stava a sinistra (spec
            2026-11-19-tema-chiaro-sito-design.md, §6.3, nel repo team-tasks-manager); dal 2026-11-19 sta solo
            nell'intestazione. Sopra gli 820 px la riga è nascosta. */}
        <div class="docs-side-top">
          <button class="docs-side-close" id="docs-side-close" aria-label={testo('menu.chiudi')}>&times;</button>
        </div>
        <DocsSearch lingua={lingua} />
        {/* L'indice della documentazione: prima voce, sopra i gruppi, così da ogni pagina si torna all'elenco. */}
        <a href={percorso(lingua, '/docs/')} class="side-overview">{testo('panoramica')}</a>
        {grouped.map((g) => (
          <div>
            <div class={g.place ? `grp grp-place is-${g.place}` : 'grp'}>
              {g.place && <img class="place-ic" src={POSTI[g.place].icon} alt="" />}{testo(`gruppo.${g.chiave}`)}
            </div>
            {g.items.map((it) => (
              <a href={percorso(lingua, `/docs/${it.id}/`)} class={it.id === current ? 'active' : ''}
                aria-current={it.id === current ? 'page' : undefined}>{it.data.title}{it.data.premium && <> <span class="premium-tag">Premium</span></>}</a>
            ))}
            {/* La pagina dei piani sta fuori dalla collezione docs: in fondo al gruppo Plans, mai `active`. */}
            {g.name === 'Plans' && <a href={PAGINA_PIANI.path}>{PAGINA_PIANI.title}</a>}
          </div>
        ))}
      </aside>
      {/* data-pagefind-body delimita CIO' CHE VA INDICIZZATO. Senza, Pagefind indicizza tutta la
          pagina, sidebar compresa: ogni voce del menu comparirebbe in ogni pagina e una ricerca per
          «webhook» restituirebbe tutte le pagine del sito. Effetto collaterale voluto: appena un
          attributo del genere esiste, Pagefind indicizza SOLO le pagine che lo hanno, quindi la
          ricerca copre la documentazione e non le pagine legali. */}
      <article class="prose" data-pagefind-body lang={pagina.riserva ? 'en' : undefined} data-copia={testo('copia')} data-copiato={testo('copiato')}>
        {/* La pillola del posto sta sopra il titolo: si legge prima di tutto il resto. Dice di quale dei due posti
            parlano i pulsanti della pagina. */}
        {posto && (
          <p class={`place-pill is-${posto}`} lang={pagina.riserva ? lingua : undefined}>
            <img class="place-ic" src={POSTI[posto].icon} alt="" />{testo(`posto.${posto}`)}
          </p>
        )}
        {/* Una pagina non ancora tradotta: l'inglese fa da riserva (src/lib/docs-lingua.ts), e lo si dice. */}
        {pagina.riserva && <p class="callout" lang={lingua} data-pagefind-ignore>{testo('riserva')}</p>}
        {/* L'etichetta Premium resta fuori dall'indice di Pagefind: i risultati della ricerca hanno il titolo della pagina. */}
        <h1>{data.title}{data.premium && <> <a class="premium-tag" href={percorso(lingua, '/docs/premium/')} title={t(lingua, 'comune.premium.titolo')} lang={pagina.riserva ? lingua : undefined} data-pagefind-ignore>Premium</a></>}</h1>
        {data.description && <p class="subtitle">{data.description}</p>}
        <Content />
      </article>
      {data.releases && <AperturaNoteDiRilascio />}
    </div>
  </main>
  <script>
    // Il menu della documentazione sul telefono (spec 2026-11-16-restyle-documentazione-design.md, §3.6 e §6, nel
    // repo team-tasks-manager).
    const toggle = document.getElementById('docs-menu-toggle');
    const side = document.getElementById('docs-side');
    const close = document.getElementById('docs-side-close');
    // La prima riga del pannello: a sinistra della croce è spazio vuoto, e un tocco lì chiude come un tocco sul resto
    // del pannello fuori dalle voci.
    const riga = side?.querySelector('.docs-side-top');

    // Il resto della pagina, che a menu aperto prende `inert`: il Tab resta nel pannello, uno screen reader non legge
    // quello che il pannello copre.
    const fuori = () =>
      document.querySelectorAll<HTMLElement>('.site-top, .site-nav, #docs-menu-toggle, .docs-shell > article, .site-foot');

    // La voce della pagina aperta, portata in vista dentro la barra laterale o il pannello. Scorre la barra, mai la
    // pagina: scrollIntoView muoverebbe anche la finestra.
    const voceApertaInVista = () => {
      const voce = side?.querySelector('a.active');
      if (!side || !voce) return;
      const barra = side.getBoundingClientRect();
      const v = voce.getBoundingClientRect();
      const alto = Math.max(barra.top, 0);
      const basso = Math.min(barra.bottom, window.innerHeight);
      if (v.top >= alto && v.bottom <= basso) return;
      side.scrollTop += v.top - alto - (basso - alto - v.height) / 2;
    };

    if (toggle && side && close) {
      const apri = () => {
        side.classList.add('open');
        // Su html, che passa il suo overflow alla finestra: su body il blocco non bloccherebbe niente.
        document.documentElement.classList.add('docs-menu-open');
        toggle.setAttribute('aria-expanded', 'true');
        fuori().forEach((el) => { el.inert = true; });
        voceApertaInVista();
        // Senza scorrere: il pannello resta sulla voce aperta, la croce è già in vista.
        close.focus({ preventScroll: true });
      };
      // Ogni uscita passa da qui: la croce, un tocco fuori dalle voci, Escape, una voce, la finestra che si allarga.
      // Altrimenti la pagina resterebbe bloccata. Il fuoco torna al pulsante, tranne quando si va a un'altra pagina o
      // il pulsante sparisce.
      const chiudi = (restituisci: boolean) => {
        if (!side.classList.contains('open')) return;
        side.classList.remove('open');
        document.documentElement.classList.remove('docs-menu-open');
        toggle.setAttribute('aria-expanded', 'false');
        fuori().forEach((el) => { el.inert = false; });
        if (restituisci) toggle.focus();
      };
      toggle.addEventListener('click', apri);
      close.addEventListener('click', () => chiudi(true));
      side.addEventListener('click', (e) => {
        if (e.target === side || e.target === riga) chiudi(true);
        else if (e.target instanceof Element && e.target.closest('a')) chiudi(false);
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') chiudi(true); });
      window.matchMedia('(max-width: 820px)').addEventListener('change', (e) => { if (!e.matches) chiudi(false); });
    }
    voceApertaInVista();
    // Mona Sans arriva dopo questo script: col carattere di riserva una voce lunga sta su una riga invece di due, la
    // barra è più corta e lo scorrimento si ferma prima. A caratteri pronti si rifà il conto, se nessuno ha mosso la
    // barra nel frattempo.
    const scorsaA = side?.scrollTop;
    document.fonts.ready.then(() => { if (side?.scrollTop === scorsaA) voceApertaInVista(); });

    // Il pulsante di copia sui blocchi di codice (spec 2026-11-23-documentazione-prima-i-pulsanti-design.md, §6, nel
    // repo team-tasks-manager). Lo aggiunge lo script: senza JavaScript non copierebbe. Il contenitore tiene fermo il
    // pulsante quando il blocco scorre in orizzontale.
    const ICONA_COPIA = '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>';
    const ICONA_FATTO = '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
    const articolo = document.querySelector<HTMLElement>('article.prose');
    if (articolo) {
      const etichetta = articolo.dataset.copia ?? 'Copy';
      const annuncio = document.createElement('p');
      annuncio.className = 'sr-only';
      annuncio.setAttribute('aria-live', 'polite');
      articolo.append(annuncio);
      articolo.querySelectorAll('pre').forEach((pre) => {
        const box = document.createElement('div');
        box.className = 'code-box';
        pre.replaceWith(box);
        box.append(pre);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-copy';
        btn.setAttribute('aria-label', etichetta);
        btn.title = etichetta;
        btn.innerHTML = ICONA_COPIA;
        let attesa: ReturnType<typeof setTimeout> | undefined;
        btn.addEventListener('click', async () => {
          // Gli spazi in testa restano: sono loro a fare i subtask. Via solo l'ultimo a capo.
          const testo = (pre.textContent ?? '').replace(/\n$/, '');
          try {
            await navigator.clipboard.writeText(testo);
            btn.innerHTML = ICONA_FATTO;
            btn.classList.add('done');
            annuncio.textContent = articolo.dataset.copiato ?? 'Copied';
            clearTimeout(attesa);
            attesa = setTimeout(() => {
              btn.innerHTML = ICONA_COPIA;
              btn.classList.remove('done');
              annuncio.textContent = '';
            }, 2000);
          } catch {
            // Gli appunti non disponibili: il testo resta selezionato, pronto per Ctrl+C.
            const r = document.createRange();
            r.selectNodeContents(pre);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(r);
          }
        });
        box.append(btn);
      });
    }
  </script>
</Base>
