---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import VetrinaFont from '../components/VetrinaFont.astro';
import { docsCard } from '../lib/preview-card';
import { giornoEOra, giornoEOraSeparati, htmlDellaLista, pushAccesa, riproduzione } from '../lib/esempi/discord';
import { legenda } from '../lib/esempi/legenda';
import { coiNomi } from '../lib/esempi/testo';
import { settimanaDiversa } from '../lib/esempi/ossatura';
import { prosa, prosaInLinea } from '../lib/esempi/prosa';
import type { Esempio } from '../lib/esempi/tipi';
import { casiDellaLingua } from '../lib/casi-lingua';
import type { Lingua } from '../i18n/lingue.ts';
import { percorso } from '../i18n/percorsi.ts';
import { t, traduttore } from '../i18n/t.ts';
// docs.css per la prosa; scene.css per i pezzi di Discord (le classi sc-*, con le misure di Discord); poi le regole dei
// casi d'uso.
import '../styles/docs.css';
import '../components/home/scene.css';
import '../styles/use-cases.css';

// Un caso d'uso (spec 2026-11-20-casi-d-uso-esempi-completi-design.md, §3, nel repo team-tasks-manager): la storia di
// un team che usa TTM per una settimana. L'attacco; il team; la lista com'è su Discord; il testo di Bulk update coi nomi
// del team (segnaposto leggibili, 2.5.0), con la legenda di ciò che usa; la configurazione e i webhook; la settimana, coi momenti chiave riprodotti; poi il corpo
// Markdown (la prossima volta, cosa TTM non fa, le domande), gli altri casi e l'invito. Tutto HTML statico: le
// riproduzioni le scrive al build il motore della demo della home (src/lib/esempi/discord.ts).
//
// In una lingua (spec 2026-11-19-sito-multilingua-design.md, §4.3): la route inglese è src/pages/use-cases/[slug].astro,
// quelle delle altre lingue src/pages/[lingua]/use-cases/[slug].astro. Una traduzione è un esempio intero nella sua
// lingua; dall'inglese vengono le ancore delle impostazioni e il testo push, che lì hanno nomi tradotti.
interface Props {
  lingua: Lingua;
  id: string;
}
const { lingua, id } = Astro.props;
const tt = traduttore(lingua, 'casi');
const tutti = await casiDellaLingua(lingua);
const caso = tutti.find((c) => c.id === id)!;
const { Content } = await render(caso.entry);
const altri = tutti.filter((c) => c.id !== id);
const d = caso.data;
const esempio: Esempio = d;
const { team } = d;
const inglese = caso.inglese;

// Una traduzione racconta la stessa settimana dell'inglese (src/lib/esempi/ossatura.ts): se si allontana, la build si
// ferma invece di pubblicare un esempio diverso in un'altra lingua.
const diversa = caso.entry.collection === 'casiTradotti' ? settimanaDiversa(d, inglese) : null;
if (diversa) throw new Error(`casi d'uso: /${lingua}/use-cases/${id}/ ${diversa}`);
const opzioni = { lingua, push: pushAccesa(inglese) };

const intro = await prosa(d.intro, lingua);
const look = await prosa(d.list.look, lingua);
const canaleDellaLista = team.channels.find((c) => c.id === d.list.channel)!.name;
const nomeDi = (id: string) => team.people.find((p) => p.id === id)?.name ?? '';
const impostazioni = await Promise.all(d.settings.map(async (s, i) => ({
  ...s,
  why: await prosaInLinea(s.why, lingua),
  // L'ancora della sezione di /docs/configuration/ col nome inglese dell'impostazione: «Keep the state after a
  // selection». Le ancore sono inglesi in ogni lingua.
  ancora: inglese.settings[i].setting.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
})));
const webhook = await Promise.all(d.webhooks.map(async (w) => ({
  ...w,
  setup: await prosa(w.setup, lingua),
  comando: tt('webhook.comando', { nome: w.name }) + (w.trigger === 'completion' ? tt('webhook.comando.evento') : ''),
})));
const maiuscola = (s: string) => s.charAt(0).toLocaleUpperCase(lingua) + s.slice(1);
const settimana = await Promise.all(d.week.map(async (m) => ({
  quando: maiuscola(giornoEOra(m.at, team.zone, lingua)),
  giorno: m.at.slice(0, 10),
  testo: await prosa(m.text, lingua),
  scheda: riproduzione(esempio, m, opzioni),
})));
// Un giorno nuovo apre un blocco della linea del tempo: la settimana si legge per giorni.
const giorni = settimana.map((m, i) => i === 0 || settimana[i - 1].giorno !== m.giorno);
const premium = d.webhooks.length > 0 || d.settings.some((s) => s.premium) || team.roles.some((r) => r.ttm);
---
<Base title={tt('caso.title', { titolo: d.seoTitle })} previewTitle={d.title} description={d.description} embed={docsCard(lingua, d.title, d.description, Astro.url.pathname, tt('caso.vedi'))}>
  <VetrinaFont slot="head" />
  <main class="docs-main">
    <article class="prose uc wrap" lang={caso.riserva ? 'en' : undefined}>
      <p class="uc-crumb" lang={caso.riserva ? lingua : undefined}><a href={percorso(lingua, '/use-cases/')}>{tt('caso.briciola')}</a></p>
      <h1>{d.title}</h1>
      <p class="subtitle">{d.description}</p>
      <Fragment set:html={intro} />

      <h2 id="the-team">{tt('team.titolo')}</h2>
      <div class="ex-team">
        <section aria-labelledby="ex-people">
          <h3 id="ex-people">{tt('team.persone')}</h3>
          <ul role="list">
            {team.people.map((p) => (
              <li><span class="ex-who"><span class="ex-dot" style={`background:${p.color}`} aria-hidden="true">{p.name.slice(0, 1)}</span>{p.name}</span><span class="ex-about">{p.about}</span></li>
            ))}
          </ul>
        </section>
        <section aria-labelledby="ex-roles">
          <h3 id="ex-roles">{tt('team.ruoli')}</h3>
          <ul role="list">
            {team.roles.map((r) => (
              <li>
                <span class="ex-who"><span class="ex-role">@{r.name}</span>{r.ttm && <a class="premium-tag" href={percorso(lingua, '/premium/')} title={t(lingua, 'comune.premium.titolo')}>Premium</a>}</span>
                <span class="ex-about">{r.about}{r.members && ` ${tt('team.membri', { nomi: r.members.map(nomeDi).join(tt('team.e')) })}`}</span>
              </li>
            ))}
          </ul>
        </section>
        <section aria-labelledby="ex-channels">
          <h3 id="ex-channels">{tt('team.canali')}</h3>
          <ul role="list">
            {team.channels.map((c) => (
              <li><span class="ex-who"><span class="ex-chan" aria-hidden="true">{c.voice ? '🔊' : '#'}</span>{c.name}</span><span class="ex-about">{c.about}</span></li>
            ))}
          </ul>
        </section>
      </div>
      <p class="ex-note" set:html={tt('team.fuso', { zona: team.zone })} />

      <h2 id="the-list">{tt('lista.titolo')}</h2>
      <p class="ex-cap">{tt('lista.dove', { canale: canaleDellaLista, ...giornoEOraSeparati(d.list.at, team.zone, lingua) })}</p>
      <div class="ex-dc">
        <Fragment set:html={htmlDellaLista(esempio, lingua)} />
      </div>
      <Fragment set:html={look} />

      <h2 id="the-text">{tt('testo.titolo')}</h2>
      <p set:html={tt('testo.spiega', { icona: '<img class="inline-ic" src="/icons/edit.png" alt="" />' })} />
      <pre class="ex-text" translate="no"><code>{coiNomi(d.list.text, team)}</code></pre>
      <dl class="ex-legend">
        {legenda(d.list.text, lingua).map((v) => (
          <div>
            <dt><code translate="no">{v.codice}</code></dt>
            <dd><Fragment set:html={v.spiega} /> <a href={v.link}>{tt('legenda.altro')}</a></dd>
          </div>
        ))}
      </dl>

      <h2 id="the-setup">{tt('impostazioni.titolo')}</h2>
      {premium && <p class="ex-note" set:html={tt('impostazioni.premium', { premium: percorso(lingua, '/premium/') })} />}
      <p set:html={tt('impostazioni.scelte', { configurazione: percorso(lingua, '/docs/configuration/') })} />
      <div class="ex-table">
        <table>
          <thead><tr><th scope="col">{tt('impostazioni.voce')}</th><th scope="col">{tt('impostazioni.scelta')}</th><th scope="col">{tt('impostazioni.perche')}</th></tr></thead>
          <tbody>
            {impostazioni.map((s) => (
              <tr>
                <th scope="row"><a href={percorso(lingua, `/docs/configuration/#${s.ancora}`)}>{s.setting}</a>{s.premium && <> <a class="premium-tag" href={percorso(lingua, '/premium/')} title={t(lingua, 'comune.premium.titolo')}>Premium</a></>}</th>
                <td>{s.choice}</td>
                <td><Fragment set:html={s.why} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {webhook.map((w, i) => (
        <section class="ex-wh" aria-labelledby={`ex-wh-${i}`}>
          <h3 id={`ex-wh-${i}`}>{tt('webhook.titolo', { nome: w.name })} <a class="premium-tag" href={percorso(lingua, '/premium/')} title={t(lingua, 'comune.premium.titolo')}>Premium</a></h3>
          <p><Fragment set:html={tt('webhook.creato', { icona: '<img class="inline-ic" src="/icons/api.png" alt="" />' })} /> {w.trigger === 'completion' ? tt('webhook.completamento') : tt('webhook.entrambi')}</p>
          <pre translate="no"><code>{w.comando}</code></pre>
          <dl class="ex-form">
            <div><dt>{tt('webhook.metodo')}</dt><dd><code translate="no">{w.method}</code></dd></div>
            <div><dt>{tt('webhook.url')}</dt><dd><code translate="no">{w.url}</code></dd></div>
            <div><dt>{tt('webhook.intestazioni')}</dt><dd><pre translate="no"><code>{w.headers.trim()}</code></pre></dd></div>
            <div><dt>{tt('webhook.body')}</dt><dd><pre translate="no"><code>{w.body.trim()}</code></pre></dd></div>
          </dl>
          <h4>{tt(`webhook.servizio.${w.service}`)}</h4>
          <Fragment set:html={w.setup} />
        </section>
      ))}

      <h2 id="the-week">{tt('settimana.titolo')}</h2>
      <ol class="ex-week" role="list">
        {settimana.map((m, i) => (
          <li data-day={giorni[i] ? '' : undefined}>
            <p class="ex-when"><time datetime={d.week[i].at}>{m.quando}</time></p>
            <div class="ex-what">
              <Fragment set:html={m.testo} />
              {m.scheda && (
                <figure class="ex-card">
                  <figcaption>{m.scheda.dove}</figcaption>
                  <div class="ex-dc"><Fragment set:html={m.scheda.html} /></div>
                </figure>
              )}
            </div>
          </li>
        ))}
      </ol>

      <Content />

      <section class="uc-more" aria-labelledby="uc-more-t">
        <h2 id="uc-more-t">{tt('altri.titolo')}</h2>
        <ul class="d-list uc-list" role="list">
          {altri.map((c) => (
            <li lang={c.riserva !== caso.riserva ? (c.riserva ? 'en' : lingua) : undefined}>
              <a href={percorso(lingua, `/use-cases/${c.id}/`)}>
                <span class="d-t">{c.data.name}</span>
                <span class="d-d">{c.data.highlights}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
      <section class="uc-final" aria-labelledby="uc-final-t">
        <h2 id="uc-final-t">{tt('finale.titolo')}</h2>
        <p set:html={tt('finale.testo')} />
        <div class="cta-row">
          <a class="btn" href="/invite">{t(lingua, 'comune.cta.aggiungi')}</a>
          <a class="btn-ghost" href={percorso(lingua, '/docs/getting-started/')}>{t(lingua, 'comune.cta.inizia')}</a>
        </div>
      </section>
    </article>
  </main>
</Base>
